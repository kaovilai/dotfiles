#!/usr/bin/env python3
"""llm-usage: visibility into which providers/models your LLM traffic really uses.

Data sources (all local, nothing leaves the machine):
  proxy   JSONL written by scripts/litellm_usage_log.py inside each LiteLLM
          proxy (requested model, served model, upstream, tokens, latency,
          errors, reroutes). Only requests made after a proxy restarts with the
          callback are present. See `llm-usage status`.
  claude  Claude Code transcripts (~/.claude/projects). History from day one,
          but only the model that answered, no requested->served routing and
          no latency.
  codex   Codex rollouts (~/.codex/sessions). Same caveats as claude.

Token columns follow Anthropic semantics: `in` is the fresh prompt, cache
read/write are separate, context = in + cache_read + cache_write. A request
with context > 200k can only have run on a 1M-window model.

Stdlib only; no state besides the logs.
"""

import bisect
import argparse
import glob
import json
import math
import os
import plistlib
import re
import shutil
import statistics
import subprocess
import sys
import time
import urllib.request
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone

STATE = os.environ.get("LLM_USAGE_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "llm-usage")
UID = os.getuid()
LONG_CTX = 200_000

# port -> (name, config path or None). LLM_USAGE_PORT_NAMES="4150=foo,4151=bar" adds/overrides names.
PROXIES = {
    "4141": ("copilot-api", None),
    "4142": ("vertex", os.path.expanduser("~/.config/claude-vertex-proxy.yaml")),
    "4145": ("openai", os.path.expanduser("~/.config/claude-openai-proxy.yaml")),
    "4146": ("enmaas", f"/tmp/claude-enmaas-proxy-{UID}-4146/config.json"),
    "4147": ("codex-hosted-only", ["~/.local/state/hosted-only-codex-4147/config.yaml",
                                   "~/.local/state/glm-hybrid-codex-4147/config.yaml"]),  # legacy path until cutover
    "4148": ("claude-hosted-only", ["~/.local/state/hosted-only-claude-4148/config.yaml",
                                    "~/.local/state/glm-hybrid-claude-4148/config.yaml"]),
}
for pair in filter(None, os.environ.get("LLM_USAGE_PORT_NAMES", "").split(",")):
    if "=" in pair:
        port, name = pair.split("=", 1)
        PROXIES[port.strip()] = (name.strip(), PROXIES.get(port.strip(), (None, None))[1])

TTY = sys.stdout.isatty()


def color(text, code):
    return f"\033[{code}m{text}\033[0m" if TTY else text


# --------------------------------------------------------------------------- model naming

def strip_model(model):
    """Display name: lowercase, provider/org prefixes, build-date suffix, [1m] and #responses dropped."""
    if not model:
        return "?"
    # "#responses" = enmaas_proxy_hooks' /v1/responses sibling route of the same model
    m = str(model).lower().replace("[1m]", "").removesuffix("#responses")
    if "glm" in m:
        return "glm-5.3" if re.search(r"5[-.]3", m) else m.split("/")[-1]
    if "deepseek" in m:
        # rits/deepseek-ai/DeepSeek-V4.1-Flash-1017 -> deepseek-v4.1-flash
        return re.sub(r"-\d{4,}$", "", m.split("/")[-1])
    for prefix in ("anthropic/", "vertex_ai/", "openai/", "bedrock/", "github_copilot/", "copilot/"):
        if m.startswith(prefix):
            m = m[len(prefix):]
    return m


def family(model):
    m = strip_model(model)
    for fam in ("opus", "sonnet", "haiku", "fable"):
        if fam in m:
            return fam
    if "glm" in m:
        return "glm"
    if "deepseek" in m:
        return "deepseek"
    if "luna" in m:
        return "luna"
    if m.startswith(("gpt", "o1", "o3", "o4")):
        return "gpt"
    if "gemini" in m:
        return "gemini"
    return m


def route_label(ev):
    req, srv = ev.get("requested"), ev.get("served")
    if req and family(req) != family(srv):
        return f"{family(req)}->{strip_model(srv)}"
    return strip_model(srv)


def is_reroute(ev):
    return bool(ev.get("requested")) and family(ev["requested"]) != family(ev["served"])


# --------------------------------------------------------------------------- loading

def parse_ts(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def parse_since(text):
    now = time.time()
    if text in (None, "all"):
        return 0.0
    if text == "today":
        return datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
    match = re.fullmatch(r"(\d+)\s*([smhdw])", text)
    if match:
        unit = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[match.group(2)]
        return now - int(match.group(1)) * unit
    ts = parse_ts(text)
    if ts is None:
        sys.exit(f"llm-usage: bad --since {text!r} (use 30m, 24h, 7d, today, all, or an ISO time)")
    return ts


def load_proxy(since):
    events = []
    for path in sorted(glob.glob(os.path.join(STATE, "events-*.jsonl"))):
        if os.path.getmtime(path) < since:
            continue
        with open(path, errors="replace") as handle:
            for line in handle:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                ts = parse_ts(ev.get("ts"))
                if ts is None or ts < since:
                    continue
                ev["t"] = ts
                ev["source"] = "proxy"
                events.append(ev)
    return events


_FILE_CACHE = {}  # (kind, path) -> (mtime, size, events); only filled by `serve`
CACHE_FILES = False


def parse_cached(kind, path, parser):
    """Parse one transcript file; `serve` keeps results until the file changes."""
    try:
        st = os.stat(path)
    except OSError:
        return []
    if CACHE_FILES:
        hit = _FILE_CACHE.get((kind, path))
        if hit and hit[0] == st.st_mtime and hit[1] == st.st_size:
            return hit[2]
    try:
        with open(path, errors="replace") as handle:
            events = parser(handle, path)
    except OSError:
        return []
    if CACHE_FILES:
        _FILE_CACHE[(kind, path)] = (st.st_mtime, st.st_size, events)
    return events


def parse_claude_file(handle, path):
    by_id = {}
    for line in handle:
        if '"usage"' not in line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        msg = obj.get("message") or {}
        usage = msg.get("usage")
        model = msg.get("model")
        if obj.get("type") != "assistant" or not usage or not model or model.startswith("<"):
            continue
        ts = parse_ts(obj.get("timestamp"))
        if ts is None:
            continue
        # Streamed messages are written several times; the last copy is final.
        key = msg.get("id") or obj.get("uuid") or len(by_id)
        by_id[key] = {
            "id": key, "t": ts, "source": "claude", "client": "claude-code", "port": "transcript",
            "served": model, "ok": True,
            "in": usage.get("input_tokens") or 0, "out": usage.get("output_tokens") or 0,
            "cache_read": usage.get("cache_read_input_tokens") or 0,
            "cache_write": usage.get("cache_creation_input_tokens") or 0,
            "reasoning": (usage.get("output_tokens_details") or {}).get("thinking_tokens") or 0,
            "session": obj.get("sessionId"),
        }
    return list(by_id.values())


def parse_codex_file(handle, path):
    events, model, last_total = [], None, -1
    for line in handle:
        if '"turn_context"' not in line and '"token_count"' not in line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        payload = obj.get("payload") or {}
        if obj.get("type") == "turn_context":
            model = payload.get("model") or model
            continue
        info = payload.get("info") if payload.get("type") == "token_count" else None
        if not info:
            continue
        total = (info.get("total_token_usage") or {}).get("total_tokens", 0)
        if total <= last_total:
            continue  # token_count is re-emitted without a new request
        last_total = total
        last = info.get("last_token_usage") or {}
        ts = parse_ts(obj.get("timestamp"))
        if ts is None or not model:
            continue
        cached = last.get("cached_input_tokens") or 0
        events.append({
            "t": ts, "source": "codex", "client": "codex", "port": "transcript",
            "served": model, "ok": True,
            "in": max((last.get("input_tokens") or 0) - cached, 0),
            "out": last.get("output_tokens") or 0, "cache_read": cached,
            "cache_write": last.get("cache_write_input_tokens") or 0,
            "reasoning": last.get("reasoning_output_tokens") or 0,
        })
    return events


def load_transcripts(kind, env, default, parser, since):
    roots = [os.path.expanduser(p) for p in os.environ.get(env, default).split(":")]
    events, seen = [], set()
    for root in roots:
        for path in glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True):
            try:
                if os.path.getmtime(path) < since:
                    continue
            except OSError:
                continue
            for e in parse_cached(kind, path, parser):
                if e["t"] < since:
                    continue
                if "id" in e:  # resumed sessions copy history into new files
                    if e["id"] in seen:
                        continue
                    seen.add(e["id"])
                events.append(e)
    return events


def load_claude(since):
    return load_transcripts("claude", "LLM_USAGE_CLAUDE_DIRS", "~/.claude/projects", parse_claude_file, since)


def load_codex(since):
    return load_transcripts("codex", "LLM_USAGE_CODEX_DIRS", "~/.codex/sessions", parse_codex_file, since)


def merge_transcripts(proxy_all, transcripts, since):
    """Proxy log where it exists; transcripts fill the rest (see load_auto)."""
    first = min(e["t"] for e in proxy_all)
    seen = {strip_model(e.get("served")) for e in proxy_all}
    extra = [e for e in transcripts if e["t"] < first or strip_model(e.get("served")) not in seen]
    return [e for e in proxy_all if e["t"] >= since] + extra, first


def load_auto(since):
    """Proxy log where it exists; transcripts fill the rest.

    Transcripts cover history from before the proxies logged, and any model the
    proxy log has never seen (traffic through a proxy that is not logging yet,
    e.g. copilot-api). Transcript calls for models the proxy log does cover are
    dropped after logging began, so nothing is counted twice.
    """
    proxy_all = load_proxy(0)
    transcripts = load_claude(since) + load_codex(since)
    if not proxy_all:
        return transcripts, "transcripts (no proxy events yet; run `llm-usage status`)"
    events, first = merge_transcripts(proxy_all, transcripts, since)
    when = datetime.fromtimestamp(first).strftime("%b %d %H:%M")
    return events, f"merged (proxy log since {when}; transcripts for earlier history and models not in the proxy log)"


def load(since, source):
    if source == "auto":
        return load_auto(since)
    if source == "all":
        return load_proxy(since) + load_claude(since) + load_codex(since), "proxy+claude+codex"
    events = []
    for name in source.split(","):
        loader = {"proxy": load_proxy, "claude": load_claude, "codex": load_codex}.get(name)
        if loader is None:
            sys.exit(f"llm-usage: unknown source {name!r} (proxy, claude, codex, auto, all)")
        events += loader(since)
    return events, source


# --------------------------------------------------------------------------- aggregation

def ctx_of(ev):
    return (ev.get("in") or 0) + (ev.get("cache_read") or 0) + (ev.get("cache_write") or 0)


def proxy_name(ev):
    port = ev.get("port")
    if port == "transcript":
        return ev.get("source", "transcript")
    return PROXIES.get(str(port), (f":{port}" if port else "?", None))[0]


# --------------------------------------------------------------------------- errors

SPARK = "▁▂▃▄▅▆▇█"
ERR_CLASSES = ("429", "5xx", "oth")
QUOTA_RE = re.compile(r"token budget exhausted|monthly token budget", re.I)
# Events logged before status fields existed: infer the class from the error text.
TEXT_STATUS = [
    (re.compile(r"RateLimitError|\b429\b|rate.?limit|slow down|token budget exhausted", re.I), 429),
    (re.compile(r"ServiceUnavailable|\b503\b|Service Unavailable", re.I), 503),
    (re.compile(r"BadGateway|\b502\b", re.I), 502),
    (re.compile(r"InternalServerError|\b500\b|timeout|APIConnectionError", re.I), 500),
    (re.compile(r"Malformed API Key|AuthenticationError|\b401\b", re.I), 401),
]


def err_status(ev):
    """(upstream status, client-visible status, inferred?) of a failed event; (None, None, False) if unknown."""
    up, cl = ev.get("upstream_status"), ev.get("status")
    if up or cl:
        return up or cl, cl or up, False
    text = ev.get("error") or ""
    for rx, code in TEXT_STATUS:
        if rx.search(text):
            return code, code, True
    return None, None, False


def err_class(ev):
    """'429' | '5xx' | 'oth' for a failed event, None for a successful one."""
    if ev.get("ok", True):
        return None
    up = err_status(ev)[0]
    if up == 429:
        return "429"
    if up and up >= 500:
        return "5xx"
    return "oth"


def err_kind(ev):
    up = err_status(ev)[0]
    if up == 429:
        if ev.get("quota") or QUOTA_RE.search(ev.get("error") or ""):
            return "quota (budget exhausted)"
        return "rate-limit"
    if up and up >= 500:
        return "server"
    if up:
        return "client"
    return "unknown"


def err_status_label(ev):
    up, cl, inferred = err_status(ev)
    if not up:
        return "?"
    text = str(up) if up == cl else f"{cl}<-{up}"
    return text + ("*" if inferred else "")


def spark(values):
    top = max(values, default=0)
    if top <= 0:
        return SPARK[0] * len(values)
    return "".join(SPARK[0] if v <= 0 else SPARK[min(len(SPARK) - 1, max(1, round(v / top * (len(SPARK) - 1))))] for v in values)


def error_buckets(events, size):
    """{bucket start: [429, 5xx, oth]} over every bucket from first to last event (zeros included)."""
    if not events:
        return {}
    first = int(min(e["t"] for e in events) // size) * size
    last = int(max(e["t"] for e in events) // size) * size
    out = {t: [0, 0, 0] for t in range(first, last + size, size)}
    for ev in events:
        cls = err_class(ev)
        if cls:
            out[int(ev["t"] // size) * size][ERR_CLASSES.index(cls)] += 1
    return out


def spike_windows(buckets, size):
    """Contiguous runs of flagged buckets: > max(3, 3x median of non-zero buckets) errors, or a 429 burst."""
    nonzero = [sum(v) for v in buckets.values() if sum(v)]
    limit = max(3, 3 * statistics.median(nonzero)) if nonzero else 3
    burst = 5 if size < 3600 else 10
    windows, cur = [], None
    for t in sorted(buckets):
        n = sum(buckets[t])
        if n > limit or buckets[t][0] >= burst:
            if cur and t - cur["end"] <= size:
                cur["end"] = t + size
                cur["buckets"].append(t)
            else:
                cur = {"start": t, "end": t + size, "buckets": [t]}
                windows.append(cur)
    for w in windows:
        w["counts"] = [sum(buckets[t][i] for t in w["buckets"]) for i in range(3)]
        w["n"] = sum(w["counts"])
        w["peak"] = max(sum(buckets[t]) for t in w["buckets"])
    return windows, limit


def bucket_size(events, choice="auto"):
    if choice == "minute":
        return 60
    if choice == "hour":
        return 3600
    span = (max(e["t"] for e in events) - min(e["t"] for e in events)) if events else 0
    return 60 if span <= 3 * 3600 else 3600


KEYS = {
    "model": lambda e: strip_model(e.get("served")),
    "requested": lambda e: strip_model(e.get("requested")) if e.get("requested") else "-",
    "route": route_label,
    "proxy": proxy_name,
    "client": lambda e: e.get("client") or "?",
    "role": lambda e: e.get("role") or "main",
    "upstream": lambda e: e.get("upstream") or "-",
    "provider": lambda e: e.get("provider") or "-",
    "dialect": lambda e: e.get("call_type") or "-",
    "status": lambda e: "ok" if e.get("ok", True) else "error",
    "source": lambda e: e.get("source", "?"),
    "day": lambda e: datetime.fromtimestamp(e["t"]).strftime("%Y-%m-%d"),
    "hour": lambda e: datetime.fromtimestamp(e["t"]).strftime("%m-%d %H:00"),
    "ctx": lambda e: ">200k (1M)" if ctx_of(e) > LONG_CTX else "<=200k",
}


def pct(values, p):
    if not values:
        return None
    values = sorted(values)
    return values[min(len(values) - 1, int(round(p / 100 * (len(values) - 1))))]


def human(n):
    if n is None:
        return "-"
    n = float(n)
    for unit, div in (("B", 1e9), ("M", 1e6), ("k", 1e3)):
        if abs(n) >= div:
            return f"{n / div:.1f}{unit}"
    return f"{int(n)}"


def ms(n):
    if n is None:
        return "-"
    return f"{n / 1000:.1f}s" if n >= 1000 else f"{int(n)}ms"


def aggregate(events, keyfns):
    groups = defaultdict(list)
    for ev in events:
        groups[tuple(fn(ev) for fn in keyfns)].append(ev)
    rows = []
    for key, evs in groups.items():
        lat = [e["ms"] for e in evs if e.get("ms") is not None]
        ttft = [e["ttft_ms"] for e in evs if e.get("ttft_ms") is not None]
        speeds = [e["out"] / ((e["ms"] - (e.get("ttft_ms") or 0)) / 1000)
                  for e in evs if e.get("ms") and e.get("out", 0) >= 20 and e["ms"] - (e.get("ttft_ms") or 0) > 200]
        cin = sum(e.get("in", 0) for e in evs)
        cread = sum(e.get("cache_read", 0) for e in evs)
        cost = sum(e["cost"] for e in evs if isinstance(e.get("cost"), (int, float)))
        rows.append({
            "key": key, "n": len(evs), "err": sum(1 for e in evs if not e.get("ok", True)),
            "e429": sum(1 for e in evs if err_class(e) == "429"), "e5xx": sum(1 for e in evs if err_class(e) == "5xx"),
            "eoth": sum(1 for e in evs if err_class(e) == "oth"),
            "err_rate": sum(1 for e in evs if not e.get("ok", True)) / len(evs),
            "in": cin, "out": sum(e.get("out", 0) for e in evs), "cread": cread,
            "hit": cread / (cin + cread) if cin + cread else None,
            "ctxmax": max(ctx_of(e) for e in evs), "long": sum(1 for e in evs if ctx_of(e) > LONG_CTX),
            "p50": pct(lat, 50), "p95": pct(lat, 95), "ttft": pct(ttft, 50),
            "tps": statistics.median(speeds) if speeds else None, "cost": cost,
            "reroutes": sum(1 for e in evs if is_reroute(e)),
        })
    if any(fn in (KEYS["day"], KEYS["hour"]) for fn in keyfns):
        return sorted(rows, key=lambda r: r["key"])
    return sorted(rows, key=lambda r: -r["n"])


def render(headers, rows, aligns=None):
    widths = [max(len(h), *(len(strip_ansi(str(r[i]))) for r in rows)) if rows else len(h) for i, h in enumerate(headers)]
    aligns = aligns or ["l"] * len(headers)

    def fmt(cells, bold=False):
        out = []
        for i, c in enumerate(cells):
            pad = widths[i] - len(strip_ansi(str(c)))
            out.append((" " * pad + str(c)) if aligns[i] == "r" else (str(c) + " " * pad))
        line = "  ".join(out).rstrip()
        return color(line, "1") if bold else line

    lines = [fmt(headers, True)] + [fmt(r) for r in rows]
    return "\n".join(lines)


def strip_ansi(text):
    return re.sub(r"\033\[[0-9;]*m", "", text)


def err_cells(r, show):
    if not show:
        return []
    return [r["e429"] or "-", r["e5xx"] or "-", r["eoth"] or "-", f"{r['err_rate'] * 100:.0f}%" if r["err"] else "-"]


def stats_table(events, by):
    keyfns = [KEYS[k] for k in by]
    rows = aggregate(events, keyfns)
    has_latency = any(r["p50"] is not None for r in rows)
    has_err = any(r["err"] for r in rows)
    headers = [k.upper() for k in by] + ["REQS", "ERR"] + (["429", "5XX", "OTH", "ERR%"] if has_err else []) \
        + ["IN", "OUT", "CACHE", "HIT%", "CTX-MAX", ">200K"]
    aligns = ["l"] * len(by) + ["r"] * (2 + (4 if has_err else 0) + 6)
    if has_latency:
        headers += ["P50", "P95", "TTFT", "TOK/S"]
        aligns += ["r"] * 4
    if any(r["cost"] for r in rows):
        headers += ["COST"]
        aligns += ["r"]

    def line_for(key, r, err_text):
        line = key + [r["n"], err_text] + err_cells(r, has_err) + [
            human(r["in"]), human(r["out"]), human(r["cread"]), f"{r['hit'] * 100:.0f}" if r["hit"] is not None else "-",
            human(r["ctxmax"]), r["long"] or "-"]
        if has_latency:
            line += [ms(r["p50"]), ms(r["p95"]), ms(r["ttft"]), f"{r['tps']:.0f}" if r["tps"] else "-"]
        if any(x["cost"] for x in rows):
            line += [f"${r['cost']:.2f}" if r["cost"] else "-"]
        return line

    body = []
    for r in rows:
        key = list(r["key"])
        if r["reroutes"]:
            key[0] = color(key[0], "35")
        body.append(line_for(key, r, color(r["err"], "31") if r["err"] else "0"))
    total = aggregate(events, [lambda e: "TOTAL"])
    if len(rows) > 1 and total:
        body.append(line_for(["TOTAL"] + [""] * (len(by) - 1), total[0], total[0]["err"]))
    return render(headers, body, aligns)


def error_spark_line(events, label="errors"):
    """One sparkline row of failures per bucket, or None when the data has none (transcripts never do)."""
    bad = [e for e in events if not e.get("ok", True)]
    if not bad:
        return None
    size = bucket_size(events)
    buckets = error_buckets(events, size)
    windows, _ = spike_windows(buckets, size)
    counts = [sum(v) for _, v in sorted(buckets.items())]
    if len(counts) > 60:  # keep one terminal line
        step = math.ceil(len(counts) / 60)
        counts = [sum(counts[i:i + step]) for i in range(0, len(counts), step)]
    c = Counter(err_class(e) for e in bad)
    unit = "min" if size == 60 else "hour"
    text = (f"{label}/{unit}  {spark(counts)}  {len(bad)} failed ({c['429']} 429, {c['5xx']} 5xx, {c['oth']} other)"
            f"  {len(windows)} spike window(s)" + ("  -> llm-usage errors --spikes" if windows else ""))
    return color(text, "31" if windows else "33")


# --------------------------------------------------------------------------- commands

def cmd_summary(args):
    events, used = load(parse_since(args.since), args.source)
    by = [b.strip() for b in args.by.split(",")]
    for b in by:
        if b not in KEYS:
            sys.exit(f"llm-usage: --by {b!r} unknown; choose from {', '.join(KEYS)}")
    if args.json:
        print(json.dumps([{**{k: v for k, v in r.items() if k != "key"}, "key": dict(zip(by, r["key"]))}
                          for r in aggregate(events, [KEYS[b] for b in by])], indent=2))
        return
    print(color(f"llm-usage  since {args.since}  by {','.join(by)}  source: {used}  events: {len(events)}", "2"))
    if not events:
        print("no events")
        return
    print(stats_table(events, by))
    spark_row = error_spark_line(events)
    if spark_row:
        print(spark_row)
    if used.startswith(("transcripts", "merged")):
        print(color("note: transcript rows show the answering model only; requested->served reroutes and latency need the proxy log.", "2"))


def cmd_routes(args):
    events, used = load(parse_since(args.since), args.source)
    events = [e for e in events if e.get("requested")]
    print(color(f"llm-usage routes  since {args.since}  source: {used}", "2"))
    if not events:
        print("no proxy events with a requested model (transcripts do not record it)")
        return
    rows = aggregate(events, [KEYS["proxy"], KEYS["requested"], lambda e: strip_model(e.get("served")), KEYS["upstream"]])
    body = []
    for r in rows:
        proxy, req, srv, up = r["key"]
        flag = color("REROUTED", "35") if family(req) != family(srv) else "direct"
        body.append([proxy, req, "->", srv, up, flag, r["n"], r["err"] or "-", r["e429"] or "-", r["e5xx"] or "-", r["eoth"] or "-",
                     f"{r['err_rate'] * 100:.0f}%" if r["err"] else "-", human(r["in"]), human(r["out"]), ms(r["p50"])])
    print(render(["PROXY", "REQUESTED", "", "SERVED", "UPSTREAM", "KIND", "REQS", "ERR", "429", "5XX", "OTH", "ERR%", "IN", "OUT", "P50"], body,
                 ["l", "l", "l", "l", "l", "l", "r", "r", "r", "r", "r", "r", "r", "r", "r"]))
    spark_row = error_spark_line(events)
    if spark_row:
        print(spark_row)
    fallbacks = sum(1 for e in events if e.get("fallback"))
    if fallbacks:
        print(color(f"{fallbacks} request(s) were served by a router fallback after a failed first attempt", "33"))


def fmt_wait(seconds):
    h, rest = divmod(int(seconds), 3600)
    m, sec = divmod(rest, 60)
    return " ".join(f"{n}{u}" for n, u in ((h, "h"), (m, "m"), (sec, "s")) if n) or "0s"


def event_line(ev):
    when = datetime.fromtimestamp(ev["t"]).strftime("%H:%M:%S")
    arrow = route_label(ev)
    if ev.get("requested") and not is_reroute(ev):
        arrow = strip_model(ev["served"])
    elif is_reroute(ev):
        arrow = color(arrow, "35")
    status = "ok " if ev.get("ok", True) else color(f"ERR {err_status_label(ev)}", "31")
    extra = []
    if ev.get("role"):
        extra.append(ev["role"])
    if ev.get("fallback"):
        extra.append("fallback")
    if ctx_of(ev) > LONG_CTX:
        extra.append("1M-ctx")
    if ev.get("retry_after"):
        extra.append(f"reset {fmt_wait(ev['retry_after'])}")
    if ev.get("error"):
        extra.append(ev["error"][:80].replace("\n", " "))
    return (f"{when} {proxy_name(ev):<18} {ev.get('client', '?'):<11} {arrow:<28} {status} "
            f"ctx {human(ctx_of(ev)):>6} out {human(ev.get('out', 0)):>5} {ms(ev.get('ms')):>7}  {' '.join(extra)}").rstrip()


def cmd_tail(args):
    seen = set()
    since = time.time() - 3600 if args.follow else parse_since(args.since)

    def fresh():
        events = [e for e in load_proxy(since) if (e["t"], e.get("start"), e.get("served"), e.get("out")) not in seen]
        events.sort(key=lambda e: e["t"])
        return events

    events = fresh()
    for ev in events[-args.n:]:
        print(event_line(ev))
    for ev in events:
        seen.add((ev["t"], ev.get("start"), ev.get("served"), ev.get("out")))
    if not args.follow:
        if not events:
            print("no proxy events (restart proxies with the usage callback: llm-usage status)")
        return
    try:
        while True:
            time.sleep(1)
            for ev in fresh():
                seen.add((ev["t"], ev.get("start"), ev.get("served"), ev.get("out")))
                print(event_line(ev), flush=True)
    except KeyboardInterrupt:
        pass


def fmt_clock(t, size):
    return datetime.fromtimestamp(t).strftime("%m-%d %H:%M" if size < 3600 else "%m-%d %H:00")


def print_spikes(events, bucket_choice):
    bad = [e for e in events if not e.get("ok", True)]
    if not bad:
        print("no failed requests, no spikes")
        return
    size = bucket_size(events, bucket_choice)
    buckets = error_buckets(events, size)
    windows, limit = spike_windows(buckets, size)
    counts = [sum(v) for _, v in sorted(buckets.items())]
    unit = "minute" if size == 60 else "hour"
    print(color(f"per-{unit} errors {fmt_clock(min(buckets), size)} -> {fmt_clock(max(buckets), size)}  "
                f"(flag: > {limit:g}/{unit} or >= {5 if size < 3600 else 10} x 429)", "2"))
    print(spark(counts[-120:]))
    if not windows:
        print("no spike windows")
        return
    rows = []
    for w in windows:
        per = [sum(buckets[t]) for t in range(w["start"], w["end"], size) if t in buckets]
        rows.append([fmt_clock(w["start"], size), fmt_clock(w["end"] - size, size), w["n"], w["counts"][0] or "-", w["counts"][1] or "-",
                     w["counts"][2] or "-", w["peak"], spark(per)])
    print(render(["FROM", "TO", "ERRORS", "429", "5XX", "OTH", f"PEAK/{unit[:3].upper()}", "SHAPE"], rows, ["l", "l", "r", "r", "r", "r", "r", "l"]))


def print_drift(events):
    """Closing block when the proxy logger noticed the provider changed shape (drift notes on events; see collect_drift)."""
    rows = collect_drift(events, time.time(), window=10 ** 9)  # `events` is already limited by --since
    if not rows:
        return
    print("\n" + color("Code needs updating", "1;33") + color("  (the proxy logger saw upstream behaviour this code does not handle)", "2"))
    for r in rows:
        print(f"  {r['kind'] or '?'}  {r['detail'] or ''}  x{r['count']}  last {r['last_seen']}  [{r['proxy']}]")
        print(f"    hint: {r['hint']}")


def cmd_errors(args):
    events, used = load(parse_since(args.since), args.source)
    bad = sorted((e for e in events if not e.get("ok", True)), key=lambda e: e["t"])
    print(color(f"llm-usage errors  since {args.since}  source: {used}  events: {len(events)}  failed: {len(bad)}", "2"))
    if args.spikes:
        print_spikes(events, args.bucket)
        return
    if not bad:
        if used != "proxy":
            print(color("note: transcripts record no status codes; failures only appear in the proxy log (--source proxy).", "2"))
        print_drift(events)
        return
    for ev in bad[-args.n:]:
        print(event_line(ev))
    groups = defaultdict(list)
    for ev in bad:
        up, cl, _ = err_status(ev)
        groups[(err_status_label(ev), err_kind(ev), re.sub(r"\d{4,}", "N", (ev.get("error") or ev.get("error_type") or "?")[:90]))].append(ev["t"])
    rows = [[len(ts), st, kind, datetime.fromtimestamp(min(ts)).strftime("%m-%d %H:%M"), datetime.fromtimestamp(max(ts)).strftime("%m-%d %H:%M"), msg]
            for (st, kind, msg), ts in sorted(groups.items(), key=lambda x: -len(x[1]))[:15]]
    print("\n" + render(["COUNT", "STATUS", "KIND", "FIRST", "LAST", "MESSAGE"], rows, ["r", "l", "l", "l", "l", "l"]))
    if any(r[1].endswith("*") for r in rows):
        print(color("* status inferred from the error text (event predates status logging)", "2"))
    kinds = Counter(err_kind(e) for e in bad)
    print(color("  ".join(f"{k}: {n}" for k, n in kinds.most_common()), "2"))
    spark_row = error_spark_line(events)
    if spark_row:
        print(spark_row)
    print_drift(events)


def probe(port):
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{port}/health/liveliness", timeout=1.5)
        return True
    except Exception as err:
        # A non-LiteLLM listener (copilot-api) answers some other status: still up.
        return getattr(err, "code", None) is not None


def listener_pid(port):
    try:
        out = subprocess.run(["lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN"], capture_output=True, text=True, timeout=3).stdout.split()
        return out[0] if out else None
    except Exception:
        return None


def config_models(path):
    """path: one config file or a preference-ordered list (first existing wins)."""
    paths = [path] if isinstance(path, str) else list(path or [])
    path = next((q for q in map(os.path.expanduser, paths) if os.path.exists(q)), None)
    if not path:
        return None, None
    text = open(path, errors="replace").read()
    names = re.findall(r'"?model_name"?\s*:\s*"?([^"\s,}]+)', text)
    logging_on = "litellm_usage_log" in text
    return sorted(set(names)), logging_on


def status_rows():
    events = load_proxy(time.time() - 7 * 86400)
    last_seen, counts = {}, defaultdict(int)
    errs = defaultdict(Counter)
    for ev in events:
        port = str(ev.get("port"))
        last_seen[port] = max(last_seen.get(port, 0), ev["t"])
        counts[port] += 1
        if err_class(ev):
            errs[port][err_class(ev)] += 1
    rows = []
    for port, (name, config) in sorted(PROXIES.items()):
        up = probe(port)
        models, logging_on = config_models(config)
        if name == "copilot-api":
            code = "not-litellm" if up else "down"
        elif not up:
            code = "down"
        elif logging_on is False:
            code = "not-logging"
        elif port in last_seen:
            code = "logging"
        else:
            code = "idle" if logging_on else "unknown"
        rows.append({"port": port, "name": name, "up": up, "pid": listener_pid(port) if up else None,
                     "models": models or [], "code": code, "requests_7d": counts.get(port, 0), "errors_7d": dict(errs.get(port, {})),
                     "last_seen": last_seen.get(port)})
    return rows, events


STATE_TEXT = {
    "not-litellm": "not LiteLLM (no callback hook; use --source claude)",
    "not-logging": "up, NOT logging (run: llm-proxy-restart)",
    "idle": "logging enabled, no requests yet",
    "unknown": "up, unknown (config unreadable)",
    "down": "-",
}


def cmd_status(args):
    status, events = status_rows()
    rows = []
    for r in status:
        if r["code"] == "logging":
            state = color("logging", "32") + f" ({r['requests_7d']} reqs/7d, last {ms((time.time() - r['last_seen']) * 1000)} ago)"
            if r["errors_7d"]:
                e = r["errors_7d"]
                state += color(f" errors/7d: {sum(e.values())} ({e.get('429', 0)} 429, {e.get('5xx', 0)} 5xx, {e.get('oth', 0)} other; "
                               f"{sum(e.values()) / r['requests_7d'] * 100:.0f}%)", "31")
        else:
            state = STATE_TEXT[r["code"]]
            if r["code"] == "not-logging":
                state = color(state, "33")
        rows.append([r["port"], r["name"], color("up", "32") if r["up"] else color("down", "2"), r["pid"] or "-",
                     ",".join(r["models"]) or "-", state])
    print(render(["PORT", "PROXY", "STATE", "PID", "MODELS", "USAGE LOG"], rows))
    files = sorted(glob.glob(os.path.join(STATE, "events-*.jsonl")))
    size = sum(os.path.getsize(f) for f in files)
    print(color(f"\nlog dir {STATE}: {len(files)} file(s), {human(size)}B, {len(events)} events in last 7d", "2"))


def cmd_top(args):
    window = parse_since(args.since)
    span = time.time() - window
    try:
        while True:
            since = time.time() - span
            events = load_proxy(since)
            out = [color(f"llm-usage top  last {args.since}  {datetime.now():%H:%M:%S}  (ctrl-c to quit)", "1")]
            ups = [f"{PROXIES[p][0]}:{color('up', '32') if probe(p) else color('down', '2')}" for p in sorted(PROXIES)]
            out.append("  ".join(ups))
            if not events:
                out.append("\nno proxy events yet in this window. `llm-usage status` shows which proxies log.")
            else:
                out.append("\n" + stats_table(events, ["route"]))
                out.append("\n" + stats_table(events, ["proxy", "client"]))
                bad = [e for e in events if not e.get("ok", True)]
                out.append("\nrecent:")
                out += [event_line(e) for e in sorted(events, key=lambda e: e["t"])[-args.n:]]
                if bad:
                    out.append(color(f"\n{len(bad)} errors in window ({err_status_label(bad[-1])}); latest: {(bad[-1].get('error') or '')[:100]}", "31"))
                    out.append(error_spark_line(events))
            sys.stdout.write("\033[H\033[J" + "\n".join(out) + "\n")
            sys.stdout.flush()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass


# --------------------------------------------------------------------------- menubar

MB_LABEL = "com.kaovilai.llm-usage-menubar"
MB_RECENT, MB_HOUR, MB_WEEK = 900, 3600, 7 * 86400
MB_ASSUMED_RESET = 60  # rate-limit 429 with no retry_after: guess a minute


def iso_utc(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def next_month_utc(t):
    d = datetime.fromtimestamp(t, timezone.utc)
    nxt = d.replace(year=d.year + (d.month == 12), month=d.month % 12 + 1, day=1, hour=0, minute=0, second=0, microsecond=0)
    return nxt.timestamp()


def throttle_of(ev):
    """(reset epoch, kind, basis) a 429 implies; an estimate from the log unless the event carries an upstream `reset_source`."""
    kind = ev.get("throttle_kind") or ("quota" if err_kind(ev).startswith("quota") else "rate-limit")
    try:  # the logger records an upstream-reported reset as epoch `reset_at` (+ `reset_source`); it beats every guess
        if ev.get("reset_at") and float(ev["reset_at"]) > 0:
            return float(ev["reset_at"]), kind, ev.get("reset_source") or "reset_at"
    except (TypeError, ValueError):
        pass
    if ev.get("retry_after"):
        return ev["t"] + float(ev["retry_after"]), kind, "retry_after"
    if kind == "quota":
        return next_month_utc(ev["t"]), kind, "next-month-utc"
    return ev["t"] + MB_ASSUMED_RESET, kind, f"assumed-{MB_ASSUMED_RESET}s"


def active_throttle(events, now):
    """The 429 whose reset is furthest in the future, or None. A later success on the same proxy+model proves it is not blocked."""
    ok_after = {}
    for ev in events:
        if ev.get("ok", True):
            key = (str(ev.get("port")), strip_model(ev.get("served")))
            ok_after[key] = max(ok_after.get(key, 0), ev["t"])
    best = None
    for ev in events:
        if err_class(ev) != "429":
            continue
        reset, kind, basis = throttle_of(ev)
        key = (str(ev.get("port")), strip_model(ev.get("served")))
        if reset <= now or ok_after.get(key, 0) > ev["t"]:
            continue
        if best is None or reset > best[0]:
            best = (reset, kind, basis, ev)
    if not best:
        return None
    reset, kind, basis, ev = best
    return {"proxy": proxy_name(ev), "port": str(ev.get("port")), "model": strip_model(ev.get("served")), "kind": kind,
            "at": iso_utc(ev["t"]), "reset_at": iso_utc(reset), "seconds_left": int(math.ceil(reset - now)),
            "estimate": reset_estimated(ev), "estimated": reset_estimated(ev), "reset_source": ev.get("reset_source") or None, "basis": basis}


def reset_estimated(ev):
    """False only when the logger recorded an upstream-reported reset (`reset_source` = upstream-header:*/upstream-body:*)."""
    return not str(ev.get("reset_source") or "").startswith("upstream")


def collect_drift(events, now, window=MB_WEEK):
    """Distinct `drift` notes the logger attached to events (kind, detail, hint) over the window, newest first; absent field = none."""
    agg = {}
    for ev in events:
        if ev["t"] < now - window or not isinstance(ev.get("drift"), list):
            continue
        for note in ev["drift"]:
            if not isinstance(note, dict) or not note.get("hint"):
                continue
            proxy = proxy_name(ev)
            row = agg.setdefault((note.get("kind"), note.get("detail"), note["hint"], proxy),
                                 {"kind": note.get("kind"), "detail": note.get("detail"), "hint": note["hint"], "count": 0, "last": 0, "proxy": proxy})
            row["count"] += 1
            row["last"] = max(row["last"], ev["t"])
    return [{**{k: v for k, v in r.items() if k != "last"}, "last_seen": iso_utc(r["last"])} for r in sorted(agg.values(), key=lambda r: -r["last"])]


THROTTLE_TEXT = re.compile(r"\[429\]|rate_limit|usage_limit_reached|Request rejected \(429\)|API Error: 429|\"status\":\s*429", re.I)
ROUTED_MODEL = re.compile(r"API Error: \d+ \[([^\]]+)\]")  # "API Error: 503 [rits/zai-org/glm-5-3] [429]": a named proxy answered, already in its log
LITELLM_TEXT = re.compile(r"No deployments available|litellm", re.I)  # a LiteLLM proxy (hosted-only), never copilot-api
LAST_MODEL = re.compile(r'"model":\s*"([^"<][^"]*)"')
QUOTAISH = re.compile(r"quota|exceed|premium|budget|402", re.I)


def copilot_throttle_kind(status, text):
    """'rate-limit' | 'quota' | None: does this client-visible failure look like Copilot throttling (429, 402, 403, 503 upstream rate limited)?"""
    if status == 402:
        return "quota"
    if status == 429:
        return "quota" if QUOTA_RE.search(text) else "rate-limit"
    if status == 403 and re.search(r"quota|rate|limit|exceed", text, re.I):
        return "quota" if QUOTAISH.search(text) else "rate-limit"
    if status == 503 and re.search(r"rate.?limited", text, re.I):
        return "rate-limit"
    return None


def parse_claude_throttles(handle, path):
    """Throttle-looking API failures from a Claude Code transcript.

    Two entry types carry them: type=system subtype=api_error (one per retried attempt: error.status, retryAttempt, maxRetries,
    retryInMs) and, once retries are exhausted, type=assistant with isApiErrorMessage + apiErrorStatus. Neither names a provider,
    so `served` is the last real model the session used (backfilled from the next one for a session's first turn); `routed` is
    set when the text shows a proxy answered (bracketed model tag, LiteLLM wording), which the proxy log already holds.
    """
    last_model, out, pending = None, [], []
    for line in handle:
        if '"api_error"' not in line and '"isApiErrorMessage"' not in line:
            if '"assistant"' in line and '"model"' in line:
                m = LAST_MODEL.search(line)
                if m:
                    last_model = m.group(1)
                    for ev in pending:
                        ev["served"] = ev["served"] or last_model
                    pending = []
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        ts = parse_ts(obj.get("timestamp"))
        if ts is None:
            continue
        err = obj.get("error") if isinstance(obj.get("error"), dict) else {}
        if obj.get("type") == "system" and obj.get("subtype") == "api_error":
            text, retry_ms = str(err.get("formatted") or err.get("message") or ""), obj.get("retryInMs")
            try:
                status = int(err.get("status"))
            except (TypeError, ValueError):
                status = None
        elif obj.get("isApiErrorMessage"):
            content = (obj.get("message") or {}).get("content")
            text = " ".join(b.get("text", "") for b in content if isinstance(b, dict)) if isinstance(content, list) else str(content or "")
            retry_ms = None
            status = obj.get("apiErrorStatus") if isinstance(obj.get("apiErrorStatus"), int) else None
            tagged = re.search(r"\[(\d{3})\]", text)
            if tagged and status != 429:  # "API Error: 503 [model] [429]": the upstream status wins over the proxy's wrapper
                status = int(tagged.group(1))
            if status is None and (obj.get("error") == "rate_limit" or THROTTLE_TEXT.search(text)):
                status = 429
        else:
            continue
        kind = copilot_throttle_kind(status, text)
        if kind is None:
            continue
        routed = ROUTED_MODEL.search(text)
        ev = {"id": obj.get("uuid"), "t": ts, "source": "claude", "client": "claude-code", "port": "4141", "via": "transcript",
              "served": last_model, "routed": routed.group(1) if routed else ("litellm" if LITELLM_TEXT.search(text) else None),
              "ok": False, "status": status, "upstream_status": status, "throttle_kind": kind,
              "attempt": obj.get("retryAttempt"), "error": " ".join(text.split())[:200]}
        if isinstance(retry_ms, (int, float)) and retry_ms > 0 and kind == "rate-limit":
            ev["retry_after"] = retry_ms / 1000.0  # Claude Code's own backoff: the best end-of-throttle hint a transcript has
        out.append(ev)
        if ev["served"] is None:
            pending.append(ev)
    return out


def load_claude_throttles(since):
    return load_transcripts("claude-throttle", "LLM_USAGE_CLAUDE_DIRS", "~/.claude/projects", parse_claude_throttles, since)


def throttle_spans(events, now, window=MB_HOUR):
    """Throttle intervals per provider that overlap the last `window` seconds.

    Each 429 opens a span at its time and ends at its reset (an estimate unless `reset_source` is upstream-*) or at the next
    success of the same provider + model, whichever comes first (a success is observed, so not an estimate). Spans of one
    provider + kind that overlap merge; different providers (and kinds) stay separate so the chart can overlay them.
    """
    overrides = provider_overrides()
    ok_times = defaultdict(list)
    for ev in events:
        if ev.get("ok", True):
            ok_times[(event_provider(ev, overrides)[0], strip_model(ev.get("served")))].append(ev["t"])
    for times in ok_times.values():
        times.sort()
    raw = []
    for ev in sorted(events, key=lambda e: e["t"]):
        if err_class(ev) != "429" and not ev.get("throttle_kind"):
            continue
        pkey, plabel = event_provider(ev, overrides)
        reset, kind, basis = throttle_of(ev)
        end, est = reset, reset_estimated(ev)
        times = ok_times[(pkey, strip_model(ev.get("served")))]
        i = bisect.bisect_right(times, ev["t"])
        if i < len(times) and times[i] < end:
            end, est = times[i], False
        raw.append({"provider": pkey, "label": plabel, "kind": kind, "start": ev["t"], "end": max(end, ev["t"]), "end_estimated": est,
                    "count": 1, "basis": basis, "reset_source": ev.get("reset_source") or None,
                    "source": "transcript" if ev.get("via") == "transcript" else "proxy-log"})
    merged = []
    for sp in sorted(raw, key=lambda s: (s["provider"], s["kind"], s["start"])):
        cur = merged[-1] if merged else None
        # 5s slack: a retry chain logs the next attempt about when the previous retryInMs ran out
        if cur and cur["provider"] == sp["provider"] and cur["kind"] == sp["kind"] and sp["start"] <= cur["end"] + 5:
            cur["count"] += 1
            if sp["end"] >= cur["end"]:
                cur.update(end=sp["end"], end_estimated=sp["end_estimated"], basis=sp["basis"], reset_source=sp["reset_source"])
        else:
            merged.append(sp)
    return [sp for sp in sorted(merged, key=lambda s: s["start"]) if sp["end"] >= now - window]


def parse_reset(raw):
    """Epoch of a quota reset: ISO datetime as given, a bare date at the end of that UTC day; None if unparseable."""
    try:
        raw = str(raw)
        d = datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        return d.timestamp() + (86400 if len(raw) <= 10 else 0)
    except (TypeError, ValueError):
        return None


def quota_spans(quota, now, window=MB_HOUR):
    """Copilot quota used up per copilot-api /usage: premium interactions, plus 5Hour/Weekly session limits when it reports them.

    The real start is unknown (/usage is a snapshot), so the span starts at the window start and says so (`start_estimated`).
    """
    if not quota:
        return []
    out = []
    probes = []
    if not quota.get("unlimited") and quota.get("remaining") is not None:
        probes.append(("premium interactions", quota["remaining"] <= 0, quota.get("reset_date"), "quota"))
    for lim in quota.get("limits") or []:
        pr, rem = lim.get("percent_remaining"), lim.get("remaining")
        probes.append((lim.get("name") or "session limit", (pr is not None and pr <= 0) or (pr is None and rem is not None and rem <= 0),
                       lim.get("reset_date"), "quota"))
    for name, exhausted, raw, kind in probes:
        if not exhausted:
            continue
        reset = parse_reset(raw)
        est = reset is None
        reset = reset or next_month_utc(now)
        if reset < now:
            continue
        out.append({"provider": "github-copilot", "label": PROVIDER_LABELS["github-copilot"], "kind": kind, "start": now - window, "start_estimated": True,
                    "end": reset, "end_estimated": est, "count": 0, "basis": f"copilot-api /usage: {name} used up",
                    "reset_source": None if est else "upstream-body:reset_date", "source": "quota"})
    return out


CLAUDE_FAMILIES = ("opus", "sonnet", "haiku", "fable")
INFLIGHT_STALE_S = 900  # keep in step with litellm_usage_log.INFLIGHT_STALE_S


def reroute_kind(ev):
    """None for a direct call, else why the served model differs from the requested one.

    alias     a Claude name (sonnet, T3's claude-sonnet-5-5, the classifier tier) served by GLM/DeepSeek
    vision    glm requested, deepseek served (image input fallback)
    fallback  the router retried on another deployment after a failed first attempt
    other     any other requested != served
    """
    req, srv = ev.get("requested"), ev.get("served")
    if ev.get("fallback"):
        return "fallback"
    if not req or family(req) == family(srv):
        return None
    if family(req) == "glm" and family(srv) == "deepseek":
        return "vision"
    if family(req) in CLAUDE_FAMILIES and family(srv) in ("glm", "deepseek"):
        return "alias"
    return "other"


def read_inflight(now):
    """Live in-flight requests from the proxies' inflight-<port>-<pid>.json files.

    Skips files of dead pids and entries older than INFLIGHT_STALE_S (crash/restart leftovers).
    Returns (entries, ports that report in-flight at all).
    """
    entries, reporting = [], set()
    for path in glob.glob(os.path.join(STATE, "inflight-*.json")):
        try:
            with open(path) as handle:
                doc = json.load(handle)
            os.kill(int(doc["pid"]), 0)
        except ProcessLookupError:
            continue
        except PermissionError:
            pass
        except (OSError, ValueError, KeyError, TypeError):
            continue
        port = str(doc.get("port") or "")
        reporting.add(port)
        for rid, req in (doc.get("requests") or {}).items():
            try:
                age = max(0.0, now - float(req["t"]))
            except (KeyError, TypeError, ValueError):
                continue
            if age <= INFLIGHT_STALE_S:
                entries.append({"port": port, "model": strip_model(req.get("model") or req.get("requested")), "seconds": int(age)})
    return entries, reporting


def copilot_quota(now):
    """premium-interaction quota from copilot-api's /usage (GitHub copilot_internal/user); cached 5 min, failures 1 min."""
    url = os.environ.get("LLM_USAGE_COPILOT_URL", "http://127.0.0.1:4141/usage")
    cache = os.path.join(STATE, "copilot-quota.json")
    try:
        with open(cache) as handle:
            hit = json.load(handle)
        if hit.get("url") == url and now - hit["at"] < (300 if hit.get("ok") else 60):
            return hit.get("quota"), hit.get("note")
    except (OSError, ValueError, KeyError):
        pass
    quota, note = None, None
    try:
        with urllib.request.urlopen(url, timeout=2.5) as resp:
            doc = json.load(resp)
        snap = (doc.get("quota_snapshots") or {}).get("premium_interactions")
        if not isinstance(snap, dict):
            raise ValueError("no premium_interactions in /usage")
        quota = {"plan": doc.get("copilot_plan"), "reset_date": doc.get("quota_reset_date_utc") or doc.get("quota_reset_date"),
                 "unlimited": bool(snap.get("unlimited")), "remaining": snap.get("remaining"), "entitlement": snap.get("entitlement"),
                 "percent_remaining": snap.get("percent_remaining"), "credits_used": snap.get("credits_used"),
                 "overage_count": snap.get("overage_count"), "token_based_billing": bool(doc.get("token_based_billing")),
                 "source": "copilot-api /usage", "fetched_at": iso_utc(now)}
        limits = []  # 5Hour-/Weekly-Session-RateLimits, when this copilot-api build reports them (Responses API snapshots)
        for name in ("5Hour-Session-RateLimits", "Weekly-Session-RateLimits"):
            lim = (doc.get("quota_snapshots") or {}).get(name) or (doc.get("copilot_quota_snapshots") or {}).get(name)
            if isinstance(lim, dict):
                limits.append({"name": name, "percent_remaining": lim.get("percent_remaining"), "remaining": lim.get("remaining"),
                               "entitlement": lim.get("entitlement"), "reset_date": lim.get("reset_date")})
        quota["limits"] = limits
    except Exception as err:
        note = f"copilot-api /usage unavailable ({type(err).__name__})"
    try:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(cache, "w") as handle:
            json.dump({"url": url, "at": now, "ok": quota is not None, "quota": quota, "note": note}, handle)
    except OSError:
        pass
    return quota, note


# Traffic-share mapping for the menubar logo image. One table per side; extend here (keys are logo keys,
# see LOGO_FILES / main.swift logoSpecs).
# Model side: served model -> (logo key, label), first regex match on the stripped name wins.
MODEL_VENDORS = [
    ("claude", "Claude", r"opus|sonnet|haiku|fable|claude"),
    ("openai", "GPT", r"gpt|luna|codex|openai|^o[134](-|$)"),
    ("glm", "GLM", r"glm|zai"),
    ("deepseek", "DeepSeek", r"deepseek"),
    ("gemini", "Gemini", r"gemini"),
]
# Provider side: proxy port -> logo key. "via: transcript" events are copilot-api traffic (see menubar_data).
PROVIDER_PORTS = {"4141": "github-copilot", "4142": "vertex", "4145": "openai", "4146": "enmaas", "4147": "enmaas", "4148": "enmaas"}
PROVIDER_LABELS = {"github-copilot": "GitHub Copilot", "vertex": "Vertex AI", "openai": "OpenAI", "enmaas": "EnMaaS",
                   "anthropic": "Anthropic", "other": "Other"}
SHARE_WINDOWS = {"15m": 900, "1h": 3600}
SHARE_METRICS = ("requests", "tokens")


def provider_overrides():
    """LLM_USAGE_PROVIDER_MAP="4149=anthropic,my-proxy=enmaas:EnMaaS (lab)": port or proxy name -> logo key[:label]."""
    out = {}
    for pair in filter(None, (p.strip() for p in os.environ.get("LLM_USAGE_PROVIDER_MAP", "").split(","))):
        if "=" in pair:
            src, dst = (x.strip() for x in pair.split("=", 1))
            key, _, label = dst.partition(":")
            if src and key:
                out[src] = (key.strip(), label.strip() or None)
    return out


def model_vendor(model):
    m = strip_model(model)
    for key, label, pattern in MODEL_VENDORS:
        if re.search(pattern, m):
            return key, label
    return "other", "Other"


def event_provider(ev, overrides):
    port = "4141" if ev.get("via") == "transcript" else str(ev.get("port") or "")
    for src in (port, proxy_name({**ev, "port": port})):
        if src in overrides:
            key, label = overrides[src]
            return key, label or PROVIDER_LABELS.get(key, key)
    key = PROVIDER_PORTS.get(port, "other")
    return key, PROVIDER_LABELS[key]


def tokens_of(ev):
    return (ev.get("in") or 0) + (ev.get("out") or 0)


def traffic_share(events, now, window="15m", metric="requests"):
    """Share of traffic per model vendor and per provider over the window (events: named proxies + copilot transcripts)."""
    window = window if window in SHARE_WINDOWS else "15m"
    sel = [e for e in events if e["t"] >= now - SHARE_WINDOWS[window]]
    use = metric if metric in SHARE_METRICS else "requests"
    if use == "tokens" and not any(tokens_of(e) for e in sel):
        use = "requests"  # nothing carries token counts: fall back rather than draw an empty image
    overrides = provider_overrides()

    def side(keyfn, extra=None):
        acc = {}
        for e in sel:
            key, label = keyfn(e)
            row = acc.setdefault(key, {"key": key, "label": label, "requests": 0, "tokens": 0, "_models": Counter()})
            row["requests"] += 1
            row["tokens"] += tokens_of(e)
            row["_models"][strip_model(e.get("served"))] += 1
        total = sum(r[use] for r in acc.values()) or 1
        rows = sorted(acc.values(), key=lambda r: (-r[use], r["key"]))
        for r in rows:
            r["share"] = round(r[use] / total, 4)
            top = [m for m, _ in r.pop("_models").most_common(3)]
            if extra:
                r.update(extra(r, top))
        return rows

    return {"window": window, "metric": use, "metric_requested": metric, "total": len(sel),
            "models": side(model_key_of, lambda r, top: {"vendor": r["key"], "models": top}),
            "providers": side(lambda e: event_provider(e, overrides))}


def model_key_of(ev):
    return model_vendor(ev.get("served"))


def menubar_data(now=None, up_ports=None, share_window="15m", share_metric="requests"):
    """One compact JSON document for the menubar helper (and anything else that wants a status line)."""
    now = now or time.time()
    month = datetime.fromtimestamp(now, timezone.utc).replace(day=1, hour=0, minute=0, second=0, microsecond=0).timestamp()
    proxy_all = load_proxy(0)
    events = sorted((e for e in proxy_all if e["t"] >= min(now - MB_WEEK, month)), key=lambda e: e["t"])  # month start keeps an earlier quota 429 visible
    # Only the named proxies (PROXIES, plus LLM_USAGE_PORT_NAMES): throwaway test proxies on ad-hoc ports must
    # not raise down / throttled / spike alarms in the menubar.
    events = [e for e in events if str(e.get("port")) in PROXIES]
    recent = [e for e in events if e["t"] >= now - MB_HOUR]
    # Same merge as `serve`: transcript calls for models the proxy log never saw (copilot-api has no callback).
    transcripts = load_claude(now - MB_HOUR) + load_codex(now - MB_HOUR)
    if proxy_all:
        merged, _ = merge_transcripts(proxy_all, transcripts, now - MB_HOUR)
        extra = [e for e in merged if e.get("source") != "proxy"]
    else:
        extra = transcripts
    for e in extra:
        e["port"], e["via"] = "4141", "transcript"  # attributed to copilot-api: the only proxy without a usage log
    ports = dict.fromkeys(PROXIES)
    ports.update(dict.fromkeys(str(e.get("port")) for e in recent if str(e.get("port")) not in ports and e.get("port")))
    if up_ports is None:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=len(ports)) as pool:
            up = dict(zip(ports, pool.map(probe, ports)))
    else:
        up = {p: p in up_ports for p in ports}
    flights, reporting = read_inflight(now)

    def counts(evs, window):
        sel = [e for e in evs if e["t"] >= now - window]
        c = Counter(err_class(e) for e in sel if err_class(e))
        err = sum(c.values())
        out = {"requests": len(sel), "errors": {"429": c["429"], "5xx": c["5xx"], "other": c["oth"]},
               "error_rate": round(err / len(sel), 4) if sel else 0.0}
        if sel and sel[0].get("via") == "transcript":
            out["tokens"] = {k: sum(e.get(k, 0) for e in sel) for k in ("in", "out", "cache_read", "cache_write")}
        return out

    seen_week = {str(e.get("port")): e["t"] for e in events if e["t"] >= now - MB_WEEK}
    proxies = []
    for port in ports:
        evs = [e for e in recent if str(e.get("port")) == port]
        source = "proxy-log"
        if port == "4141":
            evs, source = extra, "transcript"
        mine = [f for f in flights if f["port"] == port]
        name = PROXIES.get(port, (f":{port}", None))[0]
        row = {"port": int(port) if port.isdigit() else port, "name": name, "state": "up" if up[port] else "down", "source": source,
               "expected": port in seen_week or (port == "4141" and bool(extra)),
               "last_seen_s": int(now - seen_week[port]) if port in seen_week else None,
               "inflight": ({"count": len(mine), "oldest_s": max((f["seconds"] for f in mine), default=0)} if port in reporting else None),
               "m15": counts(evs, MB_RECENT), "h1": counts(evs, MB_HOUR)}
        proxies.append(row)

    buckets = error_buckets(recent, 60)
    windows, _ = spike_windows(buckets, 60)
    live = [w for w in windows if w["end"] >= now - 600]  # a flagged minute in the last 10 minutes
    spike = {"active": bool(live), "windows": len(windows),
             "errors": sum(w["n"] for w in live), "since": iso_utc(live[0]["start"]) if live else None}

    # Usage by model / proxy and reroutes over the hour; transcript rows are flagged by `source`.
    hour = recent + extra
    by_model = defaultdict(lambda: {"requests": 0, "reroutes": 0, "sources": set()})
    by_proxy = defaultdict(lambda: {"requests": 0, "models": Counter()})
    reroutes = defaultdict(lambda: {"count": 0, "count_15m": 0})
    for e in hour:
        model, pname = strip_model(e.get("served")), proxy_name({**e, "port": e.get("port")}) if e.get("via") != "transcript" else "copilot-api"
        kind = reroute_kind(e)
        bm = by_model[model]
        bm["requests"] += 1
        bm["reroutes"] += bool(kind)
        bm["sources"].add("transcript" if e.get("via") == "transcript" else "proxy-log")
        bp = by_proxy[pname]
        bp["requests"] += 1
        bp["models"][model] += 1
        if kind:
            frm = family(e["requested"]) if family(e["requested"]) in CLAUDE_FAMILIES else strip_model(e["requested"])
            r = reroutes[(frm, model, kind, pname)]
            r["count"] += 1
            r["count_15m"] += e["t"] >= now - MB_RECENT
    total = len(hour) or 1
    minute0 = int(now // 60) * 60 - 59 * 60
    series = {k: [0] * 60 for k in ("requests", "e429", "e5xx", "eother")}
    for e in recent:  # proxy log only: transcripts carry no errors and would swamp the chart
        i = int((e["t"] - minute0) // 60)
        if 0 <= i < 60:
            series["requests"][i] += 1
            cls = err_class(e)
            if cls:
                series[{"429": "e429", "5xx": "e5xx", "oth": "eother"}[cls]][i] += 1
    by_vendor = {}  # per-minute requests by model vendor (proxy log + copilot transcripts), for the floating window's stacked bars
    for e in hour:
        i = int((e["t"] - minute0) // 60)
        if 0 <= i < 60:
            by_vendor.setdefault(model_vendor(e.get("served"))[0], [0] * 60)[i] += 1
    series["by_vendor"] = by_vendor
    overrides = provider_overrides()
    by_provider = {}  # same minutes, split by provider (the floating window draws one rate line per provider)
    labels = {}
    for e in hour:
        i = int((e["t"] - minute0) // 60)
        if 0 <= i < 60:
            key, label = event_provider(e, overrides)
            labels[key] = label
            by_provider.setdefault(key, [0] * 60)[i] += 1
    series_by_provider = {"bucket_s": 60, "start": iso_utc(minute0),
                          "providers": [{"key": k, "label": labels[k], "requests": v} for k, v in sorted(by_provider.items(), key=lambda kv: -sum(kv[1]))]}
    last_bad = [e for e in events if not e.get("ok", True)]
    last = last_bad[-1] if last_bad else None
    mine_inflight = [f for f in flights]
    oldest = max(mine_inflight, key=lambda f: f["seconds"], default=None)
    by_flight = Counter(f["model"] for f in flights)

    copilot_up = up.get("4141", False)
    quota, quota_note = copilot_quota(now) if copilot_up else (None, "copilot-api (:4141) is down")
    cop = next(p for p in proxies if p["port"] == 4141)

    # Throttle spans: named-proxy 429s, plus Copilot ones read from Claude Code transcripts (copilot-api has no usage log).
    first_t = min((e["t"] for e in proxy_all), default=None)
    seen_models = {strip_model(e.get("served")) for e in proxy_all}
    cop_thr = [e for e in load_claude_throttles(now - 6 * 3600)
               if not e.get("routed") and e.get("served") and (first_t is None or e["t"] < first_t or strip_model(e["served"]) not in seen_models)]
    spans = throttle_spans(events + extra + cop_thr, now)
    premium_reset = parse_reset(quota.get("reset_date")) if quota else None
    if premium_reset and premium_reset > now:  # a 402 seen in a transcript lasts until GitHub's quota reset
        for sp in spans:
            if sp["provider"] == "github-copilot" and sp["kind"] == "quota" and sp["source"] == "transcript":
                sp.update(end=max(sp["end"], premium_reset), end_estimated=False, reset_source="upstream-body:quota_reset_date")
    spans += quota_spans(quota, now)
    span_rows = [{**sp, "start": iso_utc(sp["start"]), "end": iso_utc(sp["end"]), "active": sp["end"] > now} for sp in spans]
    notes = {}
    if not any(sp["provider"] == "github-copilot" for sp in spans):
        notes["github-copilot"] = ("no Copilot throttle data: copilot-api keeps no usage/error log, and no Claude Code transcript failure "
                                   "(system api_error / isApiErrorMessage with status 429, 402, 403, 503) is attributable to it in the last 6h" +
                                   ("" if quota else f", and its quota is unavailable ({quota_note})"))
    elif any(sp["provider"] == "github-copilot" and sp["source"] == "transcript" for sp in spans):
        notes["github-copilot"] = "Copilot throttle spans are transcript-derived (Claude Code API-error entries), not logged by copilot-api"
    return {
        "version": 2, "generated_at": iso_utc(now), "log_dir": STATE,
        "dashboard_port": int(os.environ.get("LLM_USAGE_PORT", "4150")),
        "proxies": proxies,
        "any_down": any(p["state"] == "down" and p["expected"] for p in proxies),
        "totals": {w: {k: v for k, v in counts(recent + extra, win).items() if k != "tokens"}
                   for w, win in (("m15", MB_RECENT), ("h1", MB_HOUR))},  # proxy logs + copilot (transcript-derived)
        "throttled": active_throttle(events, now), "spike": spike,
        "inflight": {"available": bool(reporting), "count": len(flights), "oldest_s": oldest["seconds"] if oldest else 0,
                     "oldest": ({"proxy": PROXIES.get(oldest["port"], (f":{oldest['port']}", None))[0], "model": oldest["model"],
                                 "seconds": oldest["seconds"]} if oldest else None),
                     "by_model": dict(by_flight.most_common()),
                     "note": None if reporting else "no proxy reports in-flight yet (restart proxies with the updated usage callback: llm-proxy-restart); copilot-api cannot report it"},
        "by_model": [{"model": m, "requests": v["requests"], "share": round(v["requests"] / total, 3), "reroutes": v["reroutes"],
                      "sources": sorted(v["sources"])} for m, v in sorted(by_model.items(), key=lambda x: -x[1]["requests"])[:8]],
        "by_proxy": [{"proxy": n, "requests": v["requests"], "source": "transcript" if n == "copilot-api" else "proxy-log",
                      "models": [{"model": m, "requests": c} for m, c in v["models"].most_common(4)]}
                     for n, v in sorted(by_proxy.items(), key=lambda x: -x[1]["requests"])],
        "reroutes": [{"from": f, "to": t, "kind": k, "proxy": pr, **v}
                     for (f, t, k, pr), v in sorted(reroutes.items(), key=lambda x: -x[1]["count"])],
        "series": {"bucket_s": 60, "start": iso_utc(minute0), **series},
        "series_by_provider": series_by_provider,
        "throttle_spans": span_rows, "throttle_notes": notes,
        "drift": collect_drift(events, now),
        "reroutes_15m": sum(v["count_15m"] for v in reroutes.values()),
        "share": traffic_share(hour, now, share_window, share_metric),
        "copilot": {"state": "up" if copilot_up else "down", "source": "transcript",
                    "attribution": "Claude Code/Codex transcript calls for models absent from the proxy log; approximates copilot-api traffic (may include direct-API sessions)",
                    "m15": cop["m15"], "h1": cop["h1"],
                    "models": [{"model": m, "requests": c} for m, c in Counter(strip_model(e.get("served")) for e in extra).most_common(5)],
                    "inflight": None, "inflight_note": "n/a (copilot-api has no usage callback)",
                    "quota": quota, "quota_note": quota_note},
        "top_models": [{"model": m["model"], "requests": m["requests"]} for m in sorted(
            ({"model": k, "requests": v["requests"]} for k, v in by_model.items()), key=lambda x: -x["requests"])[:5]],
        "last_error": ({"at": iso_utc(last["t"]), "ago_s": int(now - last["t"]), "proxy": proxy_name(last), "model": strip_model(last.get("served")),
                        "status": err_status_label(last), "kind": err_kind(last),
                        "message": " ".join((last.get("error") or last.get("error_type") or "").split())[:160]} if last else None),
    }


def cmd_menubar_data(args):
    up = None if args.up_ports is None else set(filter(None, args.up_ports.split(",")))
    print(json.dumps(menubar_data(up_ports=up, share_window=args.share_window, share_metric=args.share_metric), separators=(",", ":")))


MB_SRC = os.path.join(os.path.dirname(os.path.realpath(__file__)), "llm-usage-menubar", "main.swift")
MB_PLIST = os.path.expanduser(f"~/Library/LaunchAgents/{MB_LABEL}.plist")


def mb_bin():
    base = os.environ.get("LLM_USAGE_MENUBAR_DIR") or os.path.expanduser("~/.local/share/llm-usage")
    return os.path.join(base, "llm-usage-menubar")


def mb_running():
    """pid of the running helper (it holds an flock on STATE/menubar.lock), else None."""
    import fcntl
    try:
        fd = os.open(os.path.join(STATE, "menubar.lock"), os.O_RDWR)
    except OSError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            try:
                return int(os.pread(fd, 32, 0).split()[0])
            except (OSError, ValueError, IndexError):
                return -1
        fcntl.flock(fd, fcntl.LOCK_UN)
        return None
    finally:
        os.close(fd)


def mb_stale():
    out = mb_bin()
    return not os.path.exists(out) or os.path.getmtime(out) < os.path.getmtime(MB_SRC)


def mb_build(force=False):
    out = mb_bin()
    if not os.path.exists(MB_SRC):
        sys.exit(f"llm-usage: menubar source missing: {MB_SRC}")
    if not force and not mb_stale():
        print(f"menubar: up to date: {out}")
        return out
    swiftc = shutil.which("swiftc") or "/usr/bin/swiftc"
    if not os.access(swiftc, os.X_OK):
        sys.exit("llm-usage: swiftc not found (install Xcode Command Line Tools: xcode-select --install)")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    tmp = out + ".tmp"
    res = subprocess.run([swiftc, "-O", "-swift-version", "5", "-o", tmp, MB_SRC], capture_output=True, text=True)
    if res.returncode:
        sys.exit(f"llm-usage: swiftc failed:\n{res.stderr.strip()}")
    os.replace(tmp, out)
    print(f"menubar: built {out}")
    return out


def mb_env():
    env = {"LLM_USAGE_BIN": os.path.realpath(__file__),
           "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:" + os.path.expanduser("~/.local/bin")}
    for key in ("LLM_USAGE_DIR", "LLM_USAGE_PORT", "LLM_USAGE_PORT_NAMES", "LLM_USAGE_PROVIDER_MAP", "LLM_USAGE_CONFIG_DIR", "LLM_USAGE_MENUBAR_DIR"):
        if os.environ.get(key):
            env[key] = os.environ[key]
    return env


def mb_log_path():
    return os.path.join(STATE, "menubar.log")


# --------------------------------------------------------------------------- menubar logos
# Logos are never committed here: `llm-usage menubar logos fetch` downloads the PNGs below from a pinned
# commit of lobehub/lobe-icons (MIT; see THIRD_PARTY_NOTICES.md), verifies each sha256, and stores them in
# <menubar dir>/logos. The logos are trademarks of their owners, used for personal status-bar display only.
# Lookup order in the helper: ~/.config/llm-usage/logos > fetched dir > installed app icon > monogram.
LOGO_REPO = "lobehub/lobe-icons"
LOGO_SHA = "ab8cbcc6ce806b923c547628132957c8a8b61509"
LOGO_LICENSE_SHA256 = "add9d7531d1b21646317a8958e38fc727506fa39d24bdecb44154d943c82753a"
LOGO_NOTICES = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "THIRD_PARTY_NOTICES.md")
# key -> (file under packages/static-png/light/, mono, sha256). mono = single-colour glyph the helper tints with the
# menubar text colour (saved as <key>.mono.png); colour logos are saved as <key>.png. No upstream icon for enmaas / other.
LOGO_FILES = {
    "claude": ("claude-color", False, "97b53fb85b3bf401ffeb8ee7c5ebad734ce9f6edc3038f242021c53bcc18e23d"),
    "anthropic": ("anthropic", True, "389105af72687ae02e5dfbbafe24ed99a84a77a6cf6ea339c13993615b64b37e"),
    "openai": ("openai", True, "8a33312f6bb17c1edddf8f9d7fbac09ce1d1d697d6601f37227afa879e94c52e"),
    "glm": ("zai", True, "e53c9c5bfac0971024d08ab812ec13682f22f12247fcc4f134b6a0f2c988fee7"),
    "deepseek": ("deepseek-color", False, "f98596fd7802ca0c5290c498fec578fa823988646332ee36c43b7920dc4936eb"),
    "gemini": ("gemini-color", False, "10c628f55d22a9725b9f9fccce7cf062b9fb68da5f7736e87010e0594d7ba6db"),
    "github-copilot": ("githubcopilot", True, "984fc3fb2708c83fcc870eabfb2a9a4cd4a2a059ac18f78200119dc37f95ce8c"),
    "vertex": ("vertexai-color", False, "d5cd06f2f2162b220a487dfb3f94ade0f7d4a8395598356e70fc623e110ccfd1"),
}


def logos_dir():
    return os.path.join(os.path.dirname(mb_bin()), "logos")


def user_logos_dir():
    return os.path.join(os.environ.get("LLM_USAGE_CONFIG_DIR") or os.path.expanduser("~/.config/llm-usage"), "logos")


def logo_fetch(from_dir=None, verify=True):
    """Download (or copy from a local checkout of the repo) the pinned logo PNGs + LICENSE; sha256-verified."""
    import hashlib
    base = f"https://raw.githubusercontent.com/{LOGO_REPO}/{LOGO_SHA}/"

    def get(rel):
        if from_dir:
            with open(os.path.join(from_dir, rel), "rb") as handle:
                return handle.read()
        req = urllib.request.Request(base + rel, headers={"User-Agent": "llm-usage"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.read()

    wanted = [(f"packages/static-png/light/{f}.png", f"{key}.mono.png" if mono else f"{key}.png", sha)
              for key, (f, mono, sha) in LOGO_FILES.items()] + [("LICENSE", "LICENSE", LOGO_LICENSE_SHA256)]
    blobs = []
    for rel, dest, sha in wanted:  # fetch + verify everything before touching the target dir
        try:
            data = get(rel)
        except (OSError, ValueError) as err:
            sys.exit(f"llm-usage: logo fetch failed for {rel}: {err}")
        got = hashlib.sha256(data).hexdigest()
        if verify and got != sha:
            sys.exit(f"llm-usage: sha256 mismatch for {rel}: expected {sha}, got {got}; nothing written")
        blobs.append((rel, dest, got, data))
    out = logos_dir()
    os.makedirs(out, exist_ok=True)
    for stale in glob.glob(os.path.join(out, "*.png")):  # a key that moved between colour and mono must not leave both
        os.remove(stale)
    for rel, dest, got, data in blobs:
        with open(os.path.join(out, dest + ".tmp"), "wb") as handle:
            handle.write(data)
        os.replace(os.path.join(out, dest + ".tmp"), os.path.join(out, dest))
    lines = ["# Logo sources", "",
             f"- Repository: https://github.com/{LOGO_REPO}", f"- Commit: {LOGO_SHA}", "- License: MIT (see LICENSE in this directory; copied from the repository)",
             "- The logos are trademarks of their respective owners (Anthropic, OpenAI, Z.ai / Zhipu AI, DeepSeek, Google, GitHub / Microsoft),",
             "  stored here for personal status-bar display only and not redistributed with the dotfiles.",
             f"- Fetched by `llm-usage menubar logos fetch`; notices: {LOGO_NOTICES}", "", "| key | file | upstream | sha256 |", "|---|---|---|---|"]
    lines += [f"| {dest[:-4] if dest.endswith('.png') else dest} | {dest} | {rel} | {got} |" for rel, dest, got, _ in blobs if dest != "LICENSE"]
    with open(os.path.join(out, "SOURCES.md"), "w") as handle:
        handle.write("\n".join(lines) + "\n")
    print(f"menubar: fetched {len(blobs) - 1} logos + LICENSE + SOURCES.md into {out} (from {from_dir or base}, commit {LOGO_SHA[:12]})")


def logo_list():
    """Which source each logo key resolves to (the helper owns the lookup; this prints its answer)."""
    out = mb_bin() if not mb_stale() else mb_build()
    env = {**os.environ, "LLM_USAGE_MENUBAR_DIR": os.path.dirname(out)}
    res = subprocess.run([out, "--list-logos"], capture_output=True, text=True, env=env)
    if res.returncode:
        sys.exit(f"llm-usage: {out} --list-logos failed: {res.stderr.strip()}")
    sys.stdout.write(res.stdout)
    print(f"custom logos: drop <key>.png|pdf|svg (colour) or <key>.mono.png (tinted to the menubar text colour) in {user_logos_dir()}")
    print(f"downloaded:   `llm-usage menubar logos fetch` -> {logos_dir()}")
    print(f"logos from https://github.com/{LOGO_REPO} @ {LOGO_SHA[:12]} (MIT), trademarks of their owners; notices: {LOGO_NOTICES}")


def cmd_menubar(args):
    action = args.action
    if action == "logos":
        if args.logos_action == "fetch":
            logo_fetch(args.from_dir, not args.no_verify)
        elif args.logos_action:
            sys.exit(f"llm-usage: unknown logos action {args.logos_action!r} (fetch)")
        else:
            logo_list()
        return
    if action == "window":
        # no IPC: the helper polls this one-line command file once a second and deletes it after acting
        cmd = args.logos_action or "toggle"
        if cmd not in ("show", "hide", "toggle"):
            sys.exit(f"llm-usage: unknown window action {cmd!r} (show|hide|toggle)")
        pid = mb_running()
        if not pid:
            sys.exit("llm-usage: menubar helper not running (llm-usage menubar run)")
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        path = os.path.join(STATE, "menubar-window.cmd")
        with open(path + ".tmp", "w") as fh:
            fh.write(cmd + "\n")
        os.replace(path + ".tmp", path)
        print(f"menubar: window {cmd} sent to pid {pid}")
    elif action == "build":
        mb_build(args.force)
    elif action == "run":
        pid = mb_running()
        if pid:
            print(f"menubar: already running (pid {pid})")
            return
        out = mb_build()
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        log = open(mb_log_path(), "ab")
        proc = subprocess.Popen([out], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                                env={**os.environ, **mb_env()})
        for _ in range(30):
            time.sleep(0.1)
            if mb_running():
                break
        print(f"menubar: started (pid {proc.pid}); log {mb_log_path()}")
    elif action == "install":
        plist = {"Label": MB_LABEL, "ProgramArguments": [mb_bin()], "RunAtLoad": True, "KeepAlive": False,
                 "EnvironmentVariables": mb_env(), "StandardOutPath": mb_log_path(), "StandardErrorPath": mb_log_path(),
                 "AbandonProcessGroup": True, "LimitLoadToSessionType": "Aqua", "ProcessType": "Interactive"}
        target = f"gui/{UID}"
        steps = [["launchctl", "bootout", f"{target}/{MB_LABEL}"], ["launchctl", "bootstrap", target, MB_PLIST]]
        if args.dry_run:
            print(f"would build {mb_bin()} from {MB_SRC} if stale ({'stale' if mb_stale() else 'up to date'})")
            print(f"would write {MB_PLIST}:")
            sys.stdout.write(plistlib.dumps(plist).decode())
            for step in steps:
                print("would run: " + " ".join(step))
            return
        mb_build()
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        os.makedirs(os.path.dirname(MB_PLIST), exist_ok=True)
        with open(MB_PLIST, "wb") as handle:
            plistlib.dump(plist, handle)
        subprocess.run(steps[0], capture_output=True)  # not loaded yet is fine
        res = subprocess.run(steps[1], capture_output=True, text=True)
        if res.returncode:
            sys.exit(f"llm-usage: launchctl bootstrap failed: {res.stderr.strip()}")
        print(f"menubar: installed {MB_PLIST} and started it (RunAtLoad: it also starts at login)")
    elif action == "uninstall":
        step = ["launchctl", "bootout", f"gui/{UID}/{MB_LABEL}"]
        if args.dry_run:
            print("would run: " + " ".join(step))
            print(f"would remove {MB_PLIST} ({'present' if os.path.exists(MB_PLIST) else 'absent'})")
            return
        subprocess.run(step, capture_output=True)
        try:
            os.remove(MB_PLIST)
            print(f"menubar: removed {MB_PLIST}")
        except OSError:
            print("menubar: no LaunchAgent plist to remove")
    elif action == "status":
        out = mb_bin()
        built = os.path.exists(out)
        print(f"built:     {'yes' if built else 'no'}  {out}" + (" (older than source: run `llm-usage menubar build`)" if built and mb_stale() else ""))
        pid = mb_running()
        print(f"running:   {'yes (pid %s)' % pid if pid else 'no'}")
        loaded = subprocess.run(["launchctl", "print", f"gui/{UID}/{MB_LABEL}"], capture_output=True).returncode == 0
        print(f"installed: {'yes' if os.path.exists(MB_PLIST) else 'no'}  {MB_PLIST}" + (" (loaded)" if loaded else ""))


# --------------------------------------------------------------------------- web dashboard

SLOTS = 8 # categorical colors in the dataviz palette; beyond that models fold into "Other"
CTX_BINS = [(0, "<8k"), (8_000, "8-32k"), (32_000, "32-128k"), (128_000, "128-200k"), (200_000, "200-500k"), (500_000, ">500k")]
BUCKETS = [60, 300, 900, 1800, 3600, 10800, 21600, 86400]


def model_colors(by_volume):
    """Stable model -> palette slot (1..8), persisted so filters never repaint a model."""
    path = os.path.join(STATE, "colors.json")
    try:
        with open(path) as handle:
            colors = json.load(handle)
    except (OSError, ValueError):
        colors = {}
    changed = False
    for model in by_volume:
        if model not in colors and len(colors) < SLOTS:
            colors[model] = len(colors) + 1
            changed = True
    if changed:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path, "w") as handle:
            json.dump(colors, handle)
    return colors


def row_json(r, keys):
    return {**dict(zip(keys, r["key"])), **{k: v for k, v in r.items() if k != "key"}}


def dashboard_data(since_text, source, hide):
    now = time.time()
    since = parse_since(since_text)
    events, used = load(since, source)
    volume = defaultdict(int)
    for ev in events:
        volume[strip_model(ev.get("served"))] += 1
    colors = model_colors(sorted(volume, key=lambda m: -volume[m]))
    if hide:
        events = [e for e in events if strip_model(e.get("served")) not in hide]
    if since <= 0:
        since = min((e["t"] for e in events), default=now - 3600)
    span = max(now - since, 60)
    size = next((b for b in BUCKETS if span / b <= 72), BUCKETS[-1])
    start = int(since // size) * size
    count = int((now - start) // size) + 1
    buckets = [start + i * size for i in range(count)]

    def label(ev):
        m = strip_model(ev.get("served"))
        return m if m in colors else "Other"

    series = {}
    lat = defaultdict(list)
    for ev in events:
        m = label(ev)
        i = min(max(int((ev["t"] - start) // size), 0), count - 1)
        s = series.setdefault(m, {k: [0] * count for k in ("req", "out", "ctx", "err")})
        s["req"][i] += 1
        s["out"][i] += ev.get("out", 0)
        s["ctx"][i] += ctx_of(ev)
        s["err"][i] += 0 if ev.get("ok", True) else 1
        if ev.get("ms") is not None:
            lat[(m, i)].append(ev["ms"])
    for m, s in series.items():
        s["p50"] = [pct(lat.get((m, i), []), 50) for i in range(count)]
        s["p95"] = [pct(lat.get((m, i), []), 95) for i in range(count)]
    order = sorted(series, key=lambda m: (m == "Other", -sum(series[m]["req"])))

    ctx_hist = {m: [0] * len(CTX_BINS) for m in order}
    for ev in events:
        c = ctx_of(ev)
        idx = max(i for i, (lo, _) in enumerate(CTX_BINS) if c >= lo)
        ctx_hist[label(ev)][idx] += 1

    total = aggregate(events, [lambda e: "all"])
    kp = total[0] if total else None
    status, _ = status_rows()
    recent = sorted(events, key=lambda e: -e["t"])[:40]
    bad = defaultdict(int)
    for ev in events:
        if not ev.get("ok", True):
            bad[(err_status_label(ev), err_kind(ev), re.sub(r"\d{4,}", "N", (ev.get("error") or "?")[:120]))] += 1
    # Failures per bucket by class, on the same x axis as the traffic chart.
    err_series = {c: [0] * count for c in ERR_CLASSES}
    for ev in events:
        cls = err_class(ev)
        if cls:
            err_series[cls][min(max(int((ev["t"] - start) // size), 0), count - 1)] += 1
    err_map = {t: [err_series[c][i] for c in ERR_CLASSES] for i, t in enumerate(buckets)}
    windows, limit = spike_windows(err_map, size)

    # why a route's served model differs (alias / vision / fallback / other), counted per route row
    route_kinds = defaultdict(Counter)
    for ev in events:
        kind = reroute_kind(ev)
        if kind:
            route_kinds[(proxy_name(ev), strip_model(ev["requested"]) if ev.get("requested") else "-", strip_model(ev.get("served")),
                         ev.get("upstream") or "-")][kind] += 1

    return {
        "now": now, "since": since, "bucket": size, "source": used, "events": len(events),
        "buckets": buckets, "models": order, "chips": [m for m in sorted(volume, key=lambda m: -volume[m]) if m in colors], "colors": {**colors, "Other": 0}, "series": series,
        "ctx_bins": [name for _, name in CTX_BINS], "ctx_hist": ctx_hist,
        "kpi": ({"n": kp["n"], "err": kp["err"], "in": kp["in"], "out": kp["out"], "cread": kp["cread"], "hit": kp["hit"],
                 "p50": kp["p50"], "p95": kp["p95"], "tps": kp["tps"], "cost": kp["cost"], "long": kp["long"],
                 "reroutes": kp["reroutes"], "classifier": sum(1 for e in events if e.get("role") == "classifier"),
                 "ctxmax": kp["ctxmax"]} if kp else None),
        "model_table": [row_json(r, ["model"]) for r in aggregate(events, [KEYS["model"]])],
        "routes": [{**row_json(r, ["proxy", "requested", "served", "upstream"]),
                    "rerouted": r["key"][1] != "-" and family(r["key"][1]) != family(r["key"][2]),
                    "kinds": route_kinds.get(r["key"], {})}
                   for r in aggregate(events, [KEYS["proxy"], KEYS["requested"], lambda e: strip_model(e.get("served")), KEYS["upstream"]])],
        "clients": [row_json(r, ["proxy", "client", "role"]) for r in aggregate(events, [KEYS["proxy"], KEYS["client"], KEYS["role"]])],
        "errors": [{"count": n, "status": st, "kind": kind, "error": e} for (st, kind, e), n in sorted(bad.items(), key=lambda x: -x[1])[:10]],
        "err_series": err_series, "err_limit": limit,
        "spikes": [{"start": w["start"], "end": w["end"], "n": w["n"], "e429": w["counts"][0], "e5xx": w["counts"][1], "eoth": w["counts"][2], "peak": w["peak"]} for w in windows],
        "recent": [{"t": e["t"], "proxy": proxy_name(e), "client": e.get("client"), "requested": strip_model(e["requested"]) if e.get("requested") else None,
                    "served": strip_model(e.get("served")), "rerouted": is_reroute(e), "ok": e.get("ok", True), "status": err_status_label(e) if not e.get("ok", True) else None, "ctx": ctx_of(e),
                    "out": e.get("out", 0), "ms": e.get("ms"), "role": e.get("role"), "fallback": bool(e.get("fallback")), "kind": reroute_kind(e),
                    "error": (e.get("error") or "")[:160] or None} for e in recent],
        "status": status,
    }


def cmd_serve(args):
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse
    global CACHE_FILES
    CACHE_FILES = True
    if args.reset_colors:
        try:
            os.remove(os.path.join(STATE, "colors.json"))
        except OSError:
            pass
    page = os.path.join(os.path.dirname(os.path.realpath(__file__)), "llm-usage-dashboard.html")
    cache, lock = {}, threading.Lock()
    allowed = {f"127.0.0.1:{args.port}", f"localhost:{args.port}", f"[::1]:{args.port}"}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, code, body, kind):
            self.send_response(code)
            self.send_header("content-type", kind)
            self.send_header("content-length", str(len(body)))
            self.send_header("cache-control", "no-store")
            self.send_header("x-content-type-options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.headers.get("host") not in allowed:  # blocks DNS rebinding
                return self.send(403, b"forbidden", "text/plain")
            url = urlparse(self.path)
            if url.path == "/favicon.ico":
                return self.send(204, b"", "image/x-icon")
            if url.path == "/":
                try:
                    with open(page, "rb") as handle:
                        return self.send(200, handle.read(), "text/html; charset=utf-8")
                except OSError:
                    return self.send(500, b"llm-usage-dashboard.html missing", "text/plain")
            if url.path == "/api/data":
                q = parse_qs(url.query)
                since = (q.get("since") or ["24h"])[0]
                source = (q.get("source") or ["auto"])[0]
                hide = tuple(sorted(filter(None, (q.get("hide") or [""])[0].split(","))))
                key = (since, source, hide)
                try:
                    with lock:
                        hit = cache.get(key)
                        if not hit or time.time() - hit[0] > args.cache:
                            hit = (time.time(), json.dumps(dashboard_data(since, source, set(hide)), separators=(",", ":"), default=str).encode())
                            cache[key] = hit
                            for k in [k for k, v in cache.items() if time.time() - v[0] > 60]:
                                del cache[k]
                    return self.send(200, hit[1], "application/json")
                except SystemExit as err:
                    return self.send(400, json.dumps({"error": str(err)}).encode(), "application/json")
            self.send(404, b"not found", "text/plain")

    try:
        server = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as err:
        sys.exit(f"llm-usage: cannot listen on {args.host}:{args.port}: {err}")
    url = f"http://127.0.0.1:{args.port}/"
    print(f"llm-usage dashboard: {url}  (ctrl-c to stop)", flush=True)
    if args.open:
        subprocess.run(["open", url], check=False)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(prog="llm-usage", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd")

    def common(p, since="24h", source="auto"):
        p.add_argument("--since", default=since, help="30m, 24h, 7d, today, all, or ISO time (default %(default)s)")
        p.add_argument("--source", default=source, help="auto|proxy|claude|codex|all or comma list (default %(default)s)")

    p = sub.add_parser("summary", help="usage table grouped by --by (default model)")
    common(p)
    p.add_argument("--by", default="model", help=f"comma list of: {', '.join(KEYS)}")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_summary)

    p = sub.add_parser("routes", help="requested -> served model matrix; flags reroutes (e.g. sonnet->glm-5.3)")
    common(p, source="proxy")
    p.set_defaults(fn=cmd_routes)

    p = sub.add_parser("tail", help="recent requests; -f to follow live")
    p.add_argument("-f", "--follow", action="store_true")
    p.add_argument("-n", type=int, default=20)
    p.add_argument("--since", default="24h")
    p.set_defaults(fn=cmd_tail)

    p = sub.add_parser("errors", help="failed requests grouped by status + message; --spikes for error bursts")
    common(p, source="proxy")
    p.add_argument("-n", type=int, default=20)
    p.add_argument("--spikes", action="store_true", help="show spike windows (error bursts) with a sparkline instead of the list")
    p.add_argument("--bucket", choices=["auto", "minute", "hour"], default="auto", help="spike bucket size (auto: minute for <=3h of data, else hour)")
    p.set_defaults(fn=cmd_errors)

    p = sub.add_parser("top", help="live dashboard")
    p.add_argument("--since", default="30m")
    p.add_argument("-n", type=int, default=8)
    p.add_argument("--interval", type=float, default=2.0)
    p.set_defaults(fn=cmd_top)

    p = sub.add_parser("status", help="which proxies are up and whether they log usage")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("serve", help="browser dashboard with graphs (localhost only)")
    p.add_argument("--port", type=int, default=int(os.environ.get("LLM_USAGE_PORT", "4150")))
    p.add_argument("--host", default="127.0.0.1", help="bind address; only loopback Host headers are accepted")
    p.add_argument("--open", action="store_true", help="open in the default browser")
    p.add_argument("--cache", type=float, default=3.0, help="seconds to reuse a computed payload")
    p.add_argument("--reset-colors", action="store_true", help="forget the stored model -> color assignments")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("menubar-data", help="compact JSON for the menubar helper: proxies, 15m/1h counts, throttle, spike")
    p.add_argument("--up-ports", help=argparse.SUPPRESS)  # tests: comma list of ports to treat as up (no probing)
    p.add_argument("--share-window", choices=list(SHARE_WINDOWS), default="15m", help="traffic-share window (default %(default)s)")
    p.add_argument("--share-metric", choices=list(SHARE_METRICS), default="requests", help="traffic-share metric (default %(default)s)")
    p.set_defaults(fn=cmd_menubar_data)

    p = sub.add_parser("menubar", help="macOS menubar monitor (native Swift helper): build|run|install|uninstall|status|logos [fetch]|window [show|hide|toggle]")
    p.add_argument("action", choices=["build", "run", "install", "uninstall", "status", "logos", "window"])
    p.add_argument("logos_action", nargs="?", help="logos: `fetch` downloads the pinned logo PNGs, omit to list what each key resolves to; window: show|hide|toggle (default toggle)")
    p.add_argument("--from-dir", help=argparse.SUPPRESS)  # logos fetch: local checkout of the logo repo instead of the network
    p.add_argument("--no-verify", action="store_true", help=argparse.SUPPRESS)  # logos fetch: tests only (fixture PNGs)
    p.add_argument("--force", action="store_true", help="build: rebuild even when up to date")
    p.add_argument("--dry-run", action="store_true", help="install/uninstall: print what would happen, change nothing")
    p.set_defaults(fn=cmd_menubar)

    args = parser.parse_args()
    if not args.cmd:
        args = parser.parse_args(["summary"])
    args.fn(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
