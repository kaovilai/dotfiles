{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/inject-commit-attribution.sh",
            "statusMessage": "Checking AI commit attribution"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "exec_command|Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/nudge-missing-ai-trailer.sh",
            "statusMessage": "Checking commit AI trailer"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.zsh) if ! out=$(zsh -n \"$f\" 2>&1); then echo \"$out\" >&2; exit 2; fi ;; esac; }",
            "statusMessage": "Checking .zsh syntax"
          }
        ]
      }
    ]
  }
}
