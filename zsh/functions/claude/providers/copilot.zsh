# ---------------------------------------------------------------------------
# claude-copilot: Claude Code via GitHub Copilot (copilot-api gateway)
#
# claude-copilot replicates the env command generated by
# `copilot-api start --claude-code` (https://github.com/kaovilai/copilot-api),
# including two not-yet-merged fixes:
#   PR #1 (kaovilai/copilot-api#1): CLAUDE_CODE_USE_VERTEX=0 and
#       CLAUDE_CODE_USE_BEDROCK=0 so an environment already configured for
#       Vertex AI/Bedrock routes to the gateway instead of erroring 403.
#   PR #2 (kaovilai/copilot-api#2): latest available model auto-selected per
#       family; ANTHROPIC_MODEL defaults to Sonnet, falling back to Opus.
#       All three per-tier ANTHROPIC_DEFAULT_{OPUS,SONNET,HAIKU}_MODEL
#       exports PR #2 generates are kept here, each pinned to the gateway's
#       detected id (its 1M-context variant when one's offered) — see the
#       block in claude-copilot() below.
# The gateway server itself runs from the local ~/git/copilot-api checkout
# (origin/dev fork), not the published npm package — see the runner block in
# claude-copilot() below. Set COPILOT_API_DIR to point elsewhere, or unset/
# rmdir that path to fall back to the commented-out bunx/npx upstream lines.

# Run from the local origin/dev checkout, not the published (upstream) package.
# alias copilot-api="npx @jeffreycao/copilot-api@latest start --claude-code"   # upstream/published, disabled
alias copilot-api="NODE_USE_SYSTEM_CA=1 bun run --cwd \$HOME/git/copilot-api ./src/main.ts start --claude-code"

# _claude_copilot_code_hash <repo_dir>: sha256 over the tracked gateway
# source (src/ and plugin/) — bun runs the TS working tree, so this is what a
# launch would start, committed or not. "none"/"empty" keep the fingerprint
# moving when a checkout appears or loses its files.
#
# Reading and hashing all ~190 files costs ~150ms (one _claude_hash_paths
# process; a per-file spawn version cost ~2.8s and dominated every
# claude-copilot launch — profiled 2026-11-07), so the result is cached keyed
# on a stat signature: inode, mtime and size of every tracked file, collected
# with the zsh/stat builtin in ~7ms. Any content change moves a file's mtime,
# changing the signature and forcing a recompute; an unchanged tree reuses
# the cached hash without reading file contents. Worst case staleness is a
# same-second, same-size rewrite that restores the old mtime — the next real
# change re-syncs it. Without zsh/stat the full hash runs every time.
#
# The `git ls-files` spawn itself (~20ms) is cached too, keyed on .git/index
# inode/mtime/size: git rewrites the index (atomically, new inode) on every
# add/rm/mv/checkout/reset that could change the tracked list, so a matching
# index stat means the cached list is current. Without zsh/stat, or on an
# unreadable index, the list is refetched every call.
_claude_copilot_code_hash() {
    local repo="$1" files f
    [[ -d "$repo/.git" ]] || { print -r -- none; return 0; }
    zmodload zsh/stat 2>/dev/null
    local -a st
    if (( $+builtins[zstat] )) && zstat -A st "$repo/.git/index" 2>/dev/null; then
        local ikey="index $st[2] $st[10] $st[8]" list_cache lcached
        list_cache="${XDG_STATE_HOME:-$HOME/.local/state}/claude-copilot-code-files.cache"
        [[ -r "$list_cache" ]] && { lcached=$(<"$list_cache"); } 2>/dev/null
        if [[ "${lcached%%$'\n'*}" == "$ikey" ]]; then
            files="${lcached#*$'\n'}"
        else
            files=$(git -C "$repo" ls-files -- src plugin 2>/dev/null) || { print -r -- none; return 0; }
            mkdir -p "${list_cache:h}" && print -r -- "$ikey"$'\n'"$files" >| "$list_cache"
        fi
    else
        files=$(git -C "$repo" ls-files -- src plugin 2>/dev/null) || { print -r -- none; return 0; }
    fi
    [[ -n "$files" ]] || { print -r -- empty; return 0; }
    local -a present=() missing=()
    for f in ${(f)files}; do
        if [[ -r "$repo/$f" ]]; then present+=("$repo/$f"); else missing+=("$f"); fi
    done
    local cache="" sig=""
    if (( $+builtins[zstat] )); then
        local cached
        for f in "${present[@]}"; do
            zstat -A st "$f" 2>/dev/null && sig+="$f $st[2] $st[10] $st[8]"$'\n' || sig+="missing $f"$'\n'
        done
        for f in "${missing[@]}"; do sig+="missing $f"$'\n'; done
        cache="${XDG_STATE_HOME:-$HOME/.local/state}/claude-copilot-code-hash.cache"
        [[ -r "$cache" ]] && { cached=$(<"$cache"); } 2>/dev/null
        # cache layout: "<sig lines...>\n<hash>"; sig ends with a newline of
        # its own, so stripping the final "\n<hash>" leaves exactly $sig
        if [[ -n "${cached:-}" && "${cached%$'\n'*}" == "$sig" ]]; then
            print -r -- "${cached##*$'\n'}"
            return 0
        fi
    fi
    local hash
    hash=$({ (( ${#present} )) && _claude_hash_paths "${present[@]}"
             for f in "${missing[@]}"; do print -r -- "missing $f"; done
           } | _claude_sha256)
    if [[ -n "$cache" ]]; then
        mkdir -p "${cache:h}" && print -r -- "$sig"$'\n'"$hash" >| "$cache"
    fi
    print -r -- "$hash"
}

claude-copilot() {
    if ! command -v jq &>/dev/null; then
        echo "❌ jq not found. Install it with: $(_claude_pkg_install_hint jq)" >&2
        return 1
    fi

    local port="${COPILOT_API_PORT:-4141}"
    local base="http://localhost:${port}"
    local log="${TMPDIR:-/tmp}/copilot-api-${port}.log"

    # Hot reload -- see _claude_proxy_sync. copilot-api reads its GitHub OAuth
    # token (github_token) and config.json only at start, so a re-login or
    # config edit restarts the gateway. The source hash below covers the code
    # bun actually runs (the TS working tree, so a pulled or uncommitted change
    # counts too). A running gateway with no recorded fingerprint is adopted.
    local capi_data="${COPILOT_API_HOME:-$HOME/.local/share/copilot-api}"
    local repo_dir="${COPILOT_API_DIR:-$HOME/git/copilot-api}"
    # llm-usage reads live in-flight requests (inflight-<port>-<pid>.json) and
    # per-request latency/TTFT rows (timings-YYYY-MM.jsonl) written by
    # copilot-api's bundled monitor plugin (caozhiyuan/copilot-api#454).
    # Part of the fingerprint so an idle gateway restarts to load it.
    local monitor="$repo_dir/plugin/gateway/monitor.mjs"
    local plugins="${COPILOT_API_PLUGINS-}" monitor_dir="${COPILOT_API_MONITOR_DIR:-${LLM_USAGE_DIR:-$HOME/.local/state/llm-usage}}"
    [[ -z "$plugins" && -r "$monitor" ]] && plugins="[\"$monitor\"]"
    local cfp
    cfp=$(_claude_proxy_fp "$(_claude_file_hash "${capi_data}/github_token" "${capi_data}/config.json" "$monitor")" "$(_claude_copilot_code_hash "$repo_dir")" "$port" "$plugins" "$monitor_dir")
    # Fetch the model list once and let it double as the serving check: the
    # health probe in _claude_proxy_sync and the "is anything serving" curl
    # below used to re-ask the same URL, three round trips per launch in the
    # steady state (profiled 2026-11-07). An empty result means not serving
    # (connection refused fails fast; a slow gateway gets 5s before that
    # verdict).
    local models_json=""
    if [[ -z "${_CLAUDE_COPILOT_FORCE_START-}" ]]; then
        models_json=$(curl -sf --max-time 5 "${base}/v1/models") || models_json=""
        # The zero-gap swap (proxies.zsh claude-copilot-restart) retires the old
        # gateway itself; this launch must not restart or kill anything on its own.
        local assume_up=0
        [[ -n "$models_json" ]] && assume_up=1
        _claude_proxy_sync claude-copilot copilot-api "${base}/v1/models" "$cfp" claude-copilot-kill 1 "$assume_up" || return 1
        # sync may have killed a stale idle gateway; its model list died with it
        (( _CLAUDE_PROXY_SYNC_KILLED )) && models_json=""
    else
        # force-start swaps in a replacement gateway; the old process's model
        # list cannot be trusted for this launch
        models_json=""
    fi

    # Start the gateway if nothing is serving yet. _CLAUDE_COPILOT_FORCE_START
    # (the zero-gap restart swap in proxies.zsh) starts a replacement ALONGSIDE
    # the still-serving old process: both listeners bind SO_REUSEPORT (the fork's
    # serve options), so this start never refuses a connection.
    if [[ -n "${_CLAUDE_COPILOT_FORCE_START-}" ]] || [[ -z "$models_json" ]]; then
        local -a runner
        local have_checkout=0 bun_bin=${commands[bun]-}
        [[ -d "$repo_dir/.git" ]] && have_checkout=1
        # WSL appends the Windows PATH, where a Windows-side npm `bun` shim
        # (/mnt/c/.../npm/bun) can resolve; it cannot run this Linux checkout.
        # The bun.sh installer's location is used when PATH has no Linux bun.
        [[ "$bun_bin" == /mnt/[a-z]/* ]] && bun_bin=
        [[ -z "$bun_bin" && -x "$HOME/.bun/bin/bun" ]] && bun_bin="$HOME/.bun/bin/bun"
        if (( have_checkout )) && [[ -n "$bun_bin" ]]; then
            # Local origin/dev checkout — bun runs the TS source directly, so
            # uncommitted work-in-progress fixes are picked up with no build step.
            runner=(env NODE_USE_SYSTEM_CA=1 "$bun_bin" run --cwd "$repo_dir" ./src/main.ts)
        elif (( ! have_checkout )); then
            echo "❌ No local checkout at ${repo_dir} (git clone -b dev https://github.com/kaovilai/copilot-api ${repo_dir}), or set COPILOT_API_DIR to point elsewhere." >&2
            return 1
        else
            echo "❌ bun not found. Install it with: $(_claude_pkg_install_hint bun 'curl -fsSL https://bun.sh/install | bash')" >&2
            echo "   (upstream/published bunx/npx fallback is disabled by default -- see the comments above this function)" >&2
            return 1
        fi
        echo "Starting copilot-api on ${base} (log: ${log})..." >&2
        if [[ -n "$plugins" ]]; then
            export COPILOT_API_PLUGINS="$plugins" COPILOT_API_MONITOR_DIR="$monitor_dir"
        fi
        _claude_proxy_start "$log" "${runner[@]}" start --port "${port}" || return 1
        local i
        # Restart-only (llm-proxy-restart): the gateway reaching /v1/models
        # needs GitHub, which may be down (flaky wifi). It is started and keeps
        # retrying on its own, so success is the process listening, not the
        # upstream answering; the model fetch below is skipped too.
        if [[ -n "${_CLAUDE_COPILOT_RESTART_ONLY-}" ]]; then
            for i in {1..60}; do
                [[ -n "$(_claude_listen_pids "$port")" ]] && break
                sleep 1
            done
            [[ -n "$(_claude_listen_pids "$port")" ]] || { echo "❌ copilot-api not listening on ${base} after 60s (log: ${log})." >&2; return 1; }
            cfp=$(_claude_proxy_fp "$(_claude_file_hash "${capi_data}/github_token" "${capi_data}/config.json" "$monitor")" "$(_claude_copilot_code_hash "$repo_dir")" "$port" "$plugins" "$monitor_dir")
            _claude_proxy_record copilot-api "$cfp"
            return 0
        fi
        for i in {1..60}; do
            curl -sf --max-time 2 "${base}/v1/models" -o /dev/null && break
            sleep 1
        done
        if ! curl -sf --max-time 2 "${base}/v1/models" -o /dev/null; then
            echo "❌ copilot-api not ready on ${base} after 60s." >&2
            echo "   First run needs GitHub device auth: tail -f ${log}" >&2
            echo "   Or run interactively once: ${runner[*]} start --port ${port}" >&2
            return 1
        fi
        # re-hash after start: the gateway may rewrite config.json itself. Same
        # inputs as the launch-time fingerprint above, or the record never
        # matches and every idle launch (and `llm-proxy-restart required`)
        # restarts a gateway that is already current.
        cfp=$(_claude_proxy_fp "$(_claude_file_hash "${capi_data}/github_token" "${capi_data}/config.json" "$monitor")" "$(_claude_copilot_code_hash "$repo_dir")" "$port" "$plugins" "$monitor_dir")
        _claude_proxy_record copilot-api "$cfp"
    fi

    [[ -n "${_CLAUDE_COPILOT_RESTART_ONLY-}" ]] && return 0
    # Steady state already has the list from the pre-sync fetch above; only a
    # freshly started (or force-swapped) gateway needs it fetched here.
    if [[ -z "$models_json" ]]; then
        models_json=$(curl -sf --max-time 10 "${base}/v1/models") || {
            echo "❌ Failed to fetch ${base}/v1/models" >&2
            return 1
        }
    fi

    # One jq pass for the per-family picks, their display names and the picker
    # extras (was nine jq spawns; see _claude_copilot_parse_models).
    local -A _tiers=()
    local -a _pairs=()
    local _kind _a _b
    while IFS=$'\t' read -r _kind _a _b; do
        case "$_kind" in
            tier)  _tiers[$_a]="$_b" ;;
            pin)   _pairs+=("$_a|$_b") ;;      # _a="family=id", _b=display name
            model) _pairs+=("=$_a") ;;          # _a="id|display name" verbatim
        esac
    done < <(_claude_copilot_parse_models "$models_json")
    local opus="${_tiers[opus]}" sonnet="${_tiers[sonnet]}" haiku="${_tiers[haiku]}" fable="${_tiers[fable]}"

    local main_model="${sonnet:-$opus}"
    if [[ -z "$main_model" ]]; then
        echo "❌ No Claude models available from ${base}/v1/models" >&2
        return 1
    fi

    echo "claude-copilot → opus: ${opus:-n/a}, sonnet: ${sonnet:-n/a}, haiku: ${haiku:-n/a}, fable: ${fable:-n/a}" >&2

    # Env block mirrors the --claude-code generated command + PR #1/#2 fixes.
    local -a envs
    envs=(
        ANTHROPIC_BASE_URL="${base}"
        ANTHROPIC_AUTH_TOKEN="dummy"
        ANTHROPIC_MODEL="${main_model}"
        CLAUDE_CODE_USE_VERTEX=0
        CLAUDE_CODE_USE_BEDROCK=0
        CLAUDE_CODE_ATTRIBUTION_HEADER=0
        CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false
        CLAUDE_CODE_DISABLE_TERMINAL_TITLE=true
        CLAUDE_CODE_ENABLE_AWAY_SUMMARY=0
        # SDK disables tool search by default for any non-first-party
        # ANTHROPIC_BASE_URL (this local gateway included) since most
        # proxies don't forward tool_reference blocks / the enabling beta
        # header. Verified this gateway's local origin/dev checkout does
        # NOT strip it: allowedAnthropicBetas in
        # src/services/copilot/create-messages.ts already allows
        # advanced-tool-use-2025-11-20, which per Anthropic's own
        # 2025-11-24 blog is the single beta flag Tool Search Tool /
        # Programmatic Tool Calling / tool_reference all share (confirmed
        # live via a 5-test suite added to that checkout — see
        # tests/create-messages.test.ts there). Safe to force back on.
        ENABLE_TOOL_SEARCH=true
    )
    # All three tiers are pinned to the gateway's detected id (via
    # _claude_copilot_latest_model, which always finds whichever version is
    # currently latest — no hardcoded version number to go stale) so each
    # tier's [1m]-suffixed variant is used when the gateway offers one,
    # rather than the CLI's own built-in default falling back to a
    # default-context id when a tier isn't pinned. Previously Opus/Haiku
    # were deliberately left unpinned (diverging from PR #2) specifically
    # so the CLI's built-in default would "stay current" -- but
    # _claude_copilot_latest_model already re-resolves the latest version
    # on every claude-copilot call, so pinning it stays just as current
    # while also actually getting the 1M-context variant when available
    # (verified: the gateway currently offers claude-opus-5[1m], but an
    # unpinned Opus tier was silently using the CLI's plain 200K default
    # instead). Still unset first, not merely omitted, in case the shell
    # already exports these for Vertex (see secrets.zsh) -- a stale pin
    # there would otherwise leak into gateway mode.
    unset ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL
    [[ -n "$opus" ]]   && envs+=(ANTHROPIC_DEFAULT_OPUS_MODEL="${opus}")
    [[ -n "$sonnet" ]] && envs+=(ANTHROPIC_DEFAULT_SONNET_MODEL="${sonnet}")
    [[ -n "$haiku" ]]  && envs+=(ANTHROPIC_DEFAULT_HAIKU_MODEL="${haiku}")
    [[ -n "$fable" ]]  && envs+=(ANTHROPIC_DEFAULT_FABLE_MODEL="${fable}")

    # `export` writes into the calling shell (not a subprocess-only scope) so
    # any later child process — including Claude Code re-entering an agent
    # shell via the left-arrow session view — inherits the gateway config
    # instead of falling back to default subscription auth.
    # `command` bypasses the claude() shell function without exec'ing a new
    # process (unlike env), avoiding claude() → claude-copilot → claude()
    # recursion while keeping the exported vars in this same shell.
    export "${envs[@]}"
    # Gateway display names (e.g. "Claude Opus 4.8") for pinned tiers and extras
    # — pins first, then extras, already ordered by _claude_copilot_parse_models.
    _claude_picker_args "${_pairs[@]}"
    _claude_invoke "${reply[@]}" "$@"
}

# claude-copilot-kill: stop a stale/unresponsive detached copilot-api gateway
# process holding COPILOT_API_PORT (default 4141), so claude-copilot's own
# startup check (curl .../v1/models) can spawn a fresh one instead of
# treating the dead-but-still-listening process as "already running". No
# saved PID (it's launched via `(... &)` in a subshell), so this finds
# whatever's listening on the port and kills it, escalating to SIGKILL if it
# won't die.
claude-copilot-kill() {
    local port="${COPILOT_API_PORT:-4141}"
    local -a pids
    # Listeners only: matching every socket on the port also hits processes
    # with an established connection TO it -- which includes the very Claude
    # Code session routing through the gateway (and our own in-flight curl
    # health-checks), so an unfiltered kill takes them down too. Same guard
    # claude-ollama-kill uses too.
    pids=("${(f)$(_claude_listen_pids "${port}")}")
    if [[ -z "${pids[1]}" ]]; then
        echo "No process listening on port ${port}."
        return 1
    fi
    echo "Killing copilot-api on port ${port} (pid: ${pids[*]})..."
    kill "${pids[@]}" 2>/dev/null
    sleep 1
    pids=("${(f)$(_claude_listen_pids "${port}")}")
    if [[ -n "${pids[1]}" ]]; then
        echo "Still alive, sending SIGKILL..."
        kill -9 "${pids[@]}" 2>/dev/null
    fi
}

# copilot-api-details: print base URL + API key for each local gateway
# (copilot-api, claude-vertex proxy), e.g. for pointing the Claude Desktop
# app at one -- same values claude-copilot()/claude-vertex() export as
# ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN, just surfaced without starting a
# claude session. Flags each gateway RUNNING/not running via its own
# liveliness check, but always prints the URL/key it WOULD use either way.
copilot-api-details() {
    local capi_port="${COPILOT_API_PORT:-4141}"
    local capi_base="http://localhost:${capi_port}"
    local capi_status="not running"
    curl -sf --max-time 2 "${capi_base}/v1/models" -o /dev/null && capi_status="running"

    local cvp_port="${CLAUDE_VERTEX_PROXY_PORT:-4142}"
    local cvp_base="http://127.0.0.1:${cvp_port}"
    local cvp_key="${CLAUDE_VERTEX_PROXY_TOKEN:-vertex-proxy-local}"
    local cvp_status="not running"
    curl -sf --max-time 2 "${cvp_base}/health/liveliness" -o /dev/null && cvp_status="running"

    echo "copilot-api gateway (${capi_status}):"
    echo "  Base URL: ${capi_base}"
    echo "  API Key:  dummy"
    echo "claude-vertex proxy (${cvp_status}):"
    echo "  Base URL: ${cvp_base}"
    echo "  API Key:  ${cvp_key}"
}

# Pre-rename names -- claude-copilot-kill is the current name.
alias kill-copilot-api='claude-copilot-kill'
alias copilot-api-kill='claude-copilot-kill'
